ObjectProperty: <http://purl.obolibrary.org/obo/RO_0000052>

    Annotations: 
        
            Annotations: <http://www.w3.org/ns/prov#wasDerivedFrom> <http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl>
        <http://purl.obolibrary.org/obo/IAO_0000111> "inheres in"@en,
        
            Annotations: <http://www.w3.org/ns/prov#wasDerivedFrom> <http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl>
        <http://purl.obolibrary.org/obo/IAO_0000112> "this fragility is a characteristic of this vase"@en,
        
            Annotations: <http://www.w3.org/ns/prov#wasDerivedFrom> <http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl>
        <http://purl.obolibrary.org/obo/IAO_0000112> "this red color is a characteristic of this apple"@en,
        
            Annotations: <http://www.w3.org/ns/prov#wasDerivedFrom> <http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl>
        <http://purl.obolibrary.org/obo/IAO_0000115> "a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence."@en,
        
            Annotations: <http://www.w3.org/ns/prov#wasDerivedFrom> <http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl>
        <http://purl.obolibrary.org/obo/IAO_0000118> "inheres_in"@en,
        
