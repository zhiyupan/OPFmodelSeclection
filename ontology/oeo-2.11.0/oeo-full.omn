    Annotations: 
        
            Annotations: <http://www.w3.org/ns/prov#wasDerivedFrom> <https://openenergyplatform.org/ontology/oeo/releases/2.11.0/imports/cco-extracted.omn>
        <http://purl.org/dc/elements/1.1/identifier> "003-BFO",
        rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl>,
        
