    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010037 -->

    <owl:AnnotationProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010037">
        <obo:IAO_0000115>A unique individual identifier is an identifier that is unique for one individual of a class. Unique individual identifiers follow usually a structure defined e.g. by a sector division.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">unique individual identifier</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/461
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/523</oeo:OEO_00020426>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/identifier"/>
    </owl:AnnotationProperty>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020425 -->

    <owl:AnnotationProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020425">
        <obo:IAO_0000115>An oekg specific annotation that indicates how an entity should be used by the OEKG.</obo:IAO_0000115>
        <rdfs:comment>allowed value: &quot;study descriptor&quot;</rdfs:comment>
        <rdfs:label>oekg annotation</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1529
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1897</oeo:OEO_00020426>
    </owl:AnnotationProperty>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020426 -->

    <owl:AnnotationProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020426">
        <obo:IAO_0000115>A term tracker annotation is an editor note used to track the history of an entity. For each change, it records the related GitHub issue and pull request.</obo:IAO_0000115>
        <obo:IAO_0000116>This annotation property was added to replace the previously used &quot;term tracker item&quot; http://purl.obolibrary.org/obo/IAO_0000233.</obo:IAO_0000116>
        <rdfs:label>term tracker annotation</rdfs:label>
        <oeo:OEO_00020426>Replace term tracker item
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1850
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1913
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1922
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1923</oeo:OEO_00020426>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
    </owl:AnnotationProperty>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020434 -->

    <owl:AnnotationProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020434">
        <rdfs:label xml:lang="en">has associated axiom(sparql)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00040001 -->

    <owl:AnnotationProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00040001">
        <obo:IAO_0000116 xml:lang="en">This annotation property was used to describe in which module a class was implemented. With OEO version 2.0.0 this annotation property gets deprecated.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">belongs to module</rdfs:label>
        <oeo:OEO_00020426 xml:lang="en">Make the annotation property deprecated
Pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1732</oeo:OEO_00020426>
    </owl:AnnotationProperty>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00110012 -->

    <owl:AnnotationProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00110012">
