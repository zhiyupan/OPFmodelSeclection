    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000286 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000286">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000183"/>
