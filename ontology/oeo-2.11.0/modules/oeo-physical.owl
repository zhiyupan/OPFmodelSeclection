pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410067 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A grid component role is a role of an energy transformation unit that is a discrete part of a supply grid serving a specific purpose.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">grid component role</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1960
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2054</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410068 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410068">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000127"/>
        <obo:IAO_0000115 xml:lang="en">Rated voltage is a Performance Specification that prescribes the intended operating voltage of some electrical artifact.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">maximum voltage</obo:IAO_0000118>
        <obo:IAO_0000119>definition adapted from: https://dlr-ve-esy.github.io/charging-ontology/CHIO_00000091.html</obo:IAO_0000119>
        <rdfs:comment xml:lang="en">Rated voltage usually means maximum voltage.</rdfs:comment>
        <rdfs:label xml:lang="en">rated voltage</rdfs:label>
        <oeo:OEO_00020426>first implementation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410070 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410070">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00110020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001942"/>
                <owl:hasValue rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A low rated voltage is a rated voltage usually used for the local distribution of electricity. Electricity at this voltage can be converted to a medium rated voltage. The usual producers feeding electricity into the grid at this voltage are smaller wind farms and solar installations. Households are the usual consumers receiving electricity at this voltage.</obo:IAO_0000115>
        <obo:IAO_0000119>https://www.smard.de/page/en/wiki-article/5884/214026</obo:IAO_0000119>
        <rdfs:label xml:lang="en">low rated voltage</rdfs:label>
        <oeo:OEO_00020426>first implementation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108
add axiom to distribution grid
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2162
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2197</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410071 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410071">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00110020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001942"/>
                <owl:hasValue rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A medium rated voltage is a rated voltage usually used for the regional distribution of electricity. Electricity at this voltage can be converted to a high or low rated voltage. The usual producers feeding electricity into the grid at this voltage are wind and solar farms. Industries can be consumers receiving electricity at this voltage.</obo:IAO_0000115>
        <obo:IAO_0000119>https://www.smard.de/page/en/wiki-article/5884/214026</obo:IAO_0000119>
        <rdfs:label xml:lang="en">medium rated voltage</rdfs:label>
        <oeo:OEO_00020426>first implementation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108
add axiom to distribution grid
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2162
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2197</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410072 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410072">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00110019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001942"/>
                <owl:hasValue rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410053"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A high rated voltage is a rated voltage usually used for the interregional distribution of electricity. Electricity at this voltage can be converted to an extra high or medium rated voltage. The usual producers feeding electricity into the grid at this voltage are natural gas and hydro power plants. Large-scale industries can be consumers receiving electricity at this voltage.</obo:IAO_0000115>
        <obo:IAO_0000119>https://www.smard.de/page/en/wiki-article/5884/214026</obo:IAO_0000119>
        <rdfs:label xml:lang="en">high rated voltage</rdfs:label>
        <oeo:OEO_00020426>first implementation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108
add axiom to transmission grid
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2162
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2197</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410073 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410073">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00110019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001942"/>
                <owl:hasValue rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An extra high rated voltage is a rated voltage usually used for the transmission of electricity. This is the usual voltage for electricity imports and exports. Electricity at this voltage can be converted to a high rated voltage. The usual producers feeding electricity into the grid at this voltage are coal and nuclear power plants, as well as offshore wind farms and hydro power plants.</obo:IAO_0000115>
        <obo:IAO_0000119>https://www.smard.de/page/en/wiki-article/5884/214026</obo:IAO_0000119>
        <rdfs:label xml:lang="en">extra high rated voltage</rdfs:label>
        <oeo:OEO_00020426>first implementation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108
add axiom to transmission grid
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2162
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2197</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00420004 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00420004">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000253"/>
        <obo:IAO_0000115 xml:lang="en">A power line for vehicles is a power line that is designed to transfer electrical energy to an electrically propelled vehicle. The conductor is installed alongside, above or embedded in the infrastructure used by the vehicles.</obo:IAO_0000115>
        <rdfs:comment>For example third rail or catenary.</rdfs:comment>
        <rdfs:label xml:lang="en">power line for vehicles</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2154
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2191</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080000 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080000">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000185"/>
        <obo:IAO_0000115 xml:lang="en">A turboshaft gas turbine is a type of gas turbine that is optimized to produce shaft power.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">turboshaft engine</obo:IAO_0000118>
        <obo:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142</obo:IAO_0000233>
        <rdfs:label xml:lang="en">turboshaft gas turbine</rdfs:label>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080001 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080001">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000185"/>
        <obo:IAO_0000115 xml:lang="en">A turboprop gas turbine is a gas turbine that drives an aircraft propeller. It works like a turboshaft turbine but is additionally able to produce jet thrust.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">turboprop engine</obo:IAO_0000118>
        <obo:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142</obo:IAO_0000233>
        <rdfs:label xml:lang="en">turboprop gas turbine</rdfs:label>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080002 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080002">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000185"/>
        <obo:IAO_0000115 xml:lang="en">A turbofan gas turbine is a gas turbine that produces jet thrust through its core engine and additional thrust through the connected fan.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">turbofan egine</obo:IAO_0000118>
        <obo:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142</obo:IAO_0000233>
        <rdfs:label xml:lang="en">turbofan gas turbine</rdfs:label>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080003 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080003">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000185"/>
        <obo:IAO_0000115 xml:lang="en">A turbojet gas turbine is a gas turbine which produces only jet thrust.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">turbojet engine</obo:IAO_0000118>
        <obo:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142</obo:IAO_0000233>
        <rdfs:label xml:lang="en">turbojet gas turbine</rdfs:label>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440000 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440000">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000253"/>
        <obo:IAO_0000115 xml:lang="en">An overhead power line is a power line that is installed above the ground.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">conductor</obo:IAO_0000118>
        <rdfs:label xml:lang="en">overhead power line</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2154
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2191</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440001 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440001">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000253"/>
        <obo:IAO_0000115 xml:lang="en">A submarine power line is a power line that is installed below the sea surface.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">undersea cable</obo:IAO_0000118>
        <rdfs:label xml:lang="en">submarine power line</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/2154
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2191</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440002 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440002">
