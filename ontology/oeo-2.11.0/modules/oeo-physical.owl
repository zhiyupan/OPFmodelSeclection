        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010395"/>
        <obo:IAO_0000115>Single axis tracking is solar tracking in which a radiation receiving surface is following the path of the sun by roting along a fixed axis. Typical axis orientations are North-South or East-West.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Einachs-Nachführung</obo:IAO_0000118>
        <rdfs:label xml:lang="en">single axis tracking</rdfs:label>
