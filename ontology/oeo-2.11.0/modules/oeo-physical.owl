        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010395"/>
        <obo:IAO_0000115>Two axis tracking is solar tracking in which a radiation receiving surface is following the sun by rotating around two axes. The surface is always oriented normal.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Zweiachs-Nachführung</obo:IAO_0000118>
        <rdfs:label xml:lang="en">two axis tracking</rdfs:label>
