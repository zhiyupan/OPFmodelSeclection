        <obo:IAO_0000115 xml:lang="en">A lithium-ion battery is a battery that is rechargeable and in which lithium ions move from the negative electrode to the positive electrode during discharge, and back when charging. Li-ion batteries use an intercalated lithium compound as one electrode material.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">LIB</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">Li-ion battery</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">Lithium-Ionen-Batterie</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">https://en.wikipedia.org/w/index.php?title=Lithium-ion_battery&amp;oldid=906786251</obo:IAO_0000119>
        <rdfs:label xml:lang="en">lithium-ion battery</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/773
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/801</oeo:OEO_00020426>
    </owl:Class>
    


