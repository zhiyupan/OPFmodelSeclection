                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000217"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001920"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410068"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An electricity grid voltage level is a quantity value reflecting the normative voltage value that an electricity grid is operating on.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">electricity grid voltage level</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1960
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2042

added &apos;prescribed by&apos; some &apos;rated voltage&apos; subclass axiom
