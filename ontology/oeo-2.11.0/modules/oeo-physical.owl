    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410053 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410053">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410060"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00040010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000218"/>
            </owl:Restriction>
        </rdf:type>
        <obo:BFO_0000050 rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410061"/>
        <oeo:OEO_00140178 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">110000</oeo:OEO_00140178>
