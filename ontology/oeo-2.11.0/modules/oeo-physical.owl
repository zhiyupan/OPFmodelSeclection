        <obo:IAO_0000115 xml:lang="en">An underground power line is a power line that is installed below the ground surface.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">underground cable</obo:IAO_0000118>
        <rdfs:label xml:lang="en">underground power line</rdfs:label>
