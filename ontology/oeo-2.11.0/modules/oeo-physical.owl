        <obo:IAO_0000115>Solar tracking is a process in which a radiation receiving surface is following the path of the sun on the sky.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Sonnennachführung</obo:IAO_0000118>
        <rdfs:label xml:lang="en">solar tracking</rdfs:label>
