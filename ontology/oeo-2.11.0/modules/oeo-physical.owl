        <obo:IAO_0000118 xml:lang="en">industrial process</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">industrieller Prozess</obo:IAO_0000118>
        <rdfs:label xml:lang="en">manufacturing process</rdfs:label>
        <skos:closeMatch rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/534
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/589

Relabel and redefine:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1726
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1840</oeo:OEO_00020426>
    </owl:Class>
    


