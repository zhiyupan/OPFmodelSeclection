    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00360015 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00360015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
