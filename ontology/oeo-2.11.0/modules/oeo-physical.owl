    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00160002 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00160002">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00160001"/>
        <obo:IAO_0000115>A primary control is a frequency control that is decentralised and automated. It reacts within seconds to frequency deviations caused by electricity supply and demand imbalances.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Primärregelung</obo:IAO_0000118>
        <rdfs:label xml:lang="en">primary control</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1202</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00160003 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00160003">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00160001"/>
        <obo:IAO_0000115>A secondary control is a frequency control that is centralised and automated. It refers to the control area of one transmission system operator. Secondary control succeeds primary control and operates for several minutes.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Sekundärregelung</obo:IAO_0000118>
        <rdfs:label xml:lang="en">secondary control</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1202</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00160004 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00160004">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00160001"/>
        <obo:IAO_0000115>A tertiary control is a frequency control that is either automated or manual. It takes over from secondary control to equalise electricity supply and demand imbalances that last for more than 15 minutes.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Minutenreserve</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">Tertiärregelung</obo:IAO_0000118>
        <rdfs:label xml:lang="en">tertiary control</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1202</oeo:OEO_00020426>
    </owl:Class>
    


