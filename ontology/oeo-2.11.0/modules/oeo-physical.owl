    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00140057 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00140057">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00140056"/>
        <obo:IAO_0000115>A theoretical flow potential is a type of flow potential that identifies the physical upper limit of an input or output of a process in a spatial region of reference per unit time.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">theoretical flow potential</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
