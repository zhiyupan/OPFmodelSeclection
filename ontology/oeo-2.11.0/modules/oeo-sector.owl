    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010202 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010202">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010320"/>
        <rdf:type rdf:nodeID="genid33"/>
