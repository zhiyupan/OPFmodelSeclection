    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010229 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010229">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000367"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010232"/>
