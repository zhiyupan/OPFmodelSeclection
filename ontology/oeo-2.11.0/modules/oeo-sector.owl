    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010359 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010359">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000227"/>
