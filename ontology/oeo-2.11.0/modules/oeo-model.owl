                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">A relation that holds between an optimisation and its objective function or objective variable.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has objective</rdfs:label>
        <oeo:OEO_00020426>correct spelling optimisation and add range &apos;objective variable&apos;
