    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00420000 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00420000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00420001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A simulation scenario is a plan specification that references a simulation configuration and contains objective specifications to motivate the planned analysis.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Simulationsszenario</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">simulation scenario</obo:IAO_0000118>
        <rdfs:comment xml:lang="en">In the simulation community, the typical term for this concept is &quot;simulation scenario&quot;, which denotes a different kind of scenario than the oeo:scenario (OEO_00000364). A simulation scenario might use an oeo:scenario as basis for its parametrisation.</rdfs:comment>
        <rdfs:comment xml:lang="en">The bearer of the simulation plan specification is the researcher, starting the simulation and analysing the results.</rdfs:comment>
        <rdfs:label xml:lang="en">simulation plan specification</rdfs:label>
        <oeo:OEO_00020426>add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2071
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2125</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00420001 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00420001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00420002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A simulation configuration is a plan specification that describes the technical setup containing simulation components, their connections, and all the exogeneous data necessary to be realised in a simulation process.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">The bearer of the simulation configuration is the simulation framework realising the simulation configuration in the simulation.</rdfs:comment>
        <rdfs:label xml:lang="en">simulation configuration</rdfs:label>
        <oeo:OEO_00020426>add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2071
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2125</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00420002 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00420002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An output creation objective is an objective specification that defines the goal to produce some output.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">output creation objective</rdfs:label>
        <oeo:OEO_00020426>add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2071
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2125</oeo:OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00420003 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00420003">
