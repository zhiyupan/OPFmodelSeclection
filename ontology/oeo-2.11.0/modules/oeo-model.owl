    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00400017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000115>Level of model uncertainty is a quality of a model that represents the degree or severity of an uncertainty.</obo:IAO_0000115>
