    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000511">
        <rdfs:domain rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000313"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000304"/>
