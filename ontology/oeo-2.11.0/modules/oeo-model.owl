        <obo:IAO_0000115 xml:lang="en">A subregion is a region of relevance that is in every respect a component of a region of relevance, but never encompasses the entire extent of a region of relevance.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Teilregion</obo:IAO_0000118>
        <rdfs:label xml:lang="en">subregion</rdfs:label>
