        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00400013"/>
        <obo:IAO_0000115>Ontological uncertainty is a nature of model uncertainty that stems from inherent variability of a phenomenon.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">ontology of uncertainty</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.researchgate.net/publication/264816512_Classifying_and_communicating_uncertainties_in_model-based_policy_analysis</obo:IAO_0000119>
