    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020022 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020022">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00020016"/>
        <obo:IAO_0000115>A model documentation is a model descriptor that contains a detailed description of a model.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Modelldokumentation</obo:IAO_0000118>
        <rdfs:label xml:lang="en">model documentation</rdfs:label>
        <oeo:OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/82
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/577</oeo:OEO_00020426>
