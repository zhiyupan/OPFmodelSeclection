        <obo:IAO_0000115 xml:lang="en">An output data creation objective is an output creation objective that defines the goal to produce output data.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">output data creation objective</rdfs:label>
        <oeo:OEO_00020426>add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2071
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2125</oeo:OEO_00020426>
    </owl:Class>
    


