    <owl:Ontology rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-model/">
        <owl:versionIRI rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-model.omn"/>
        <owl:imports rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-shared.omn"/>
        <dc:description>The Open Energy Ontology is an ontology for all aspects of the energy modelling domain. The &apos;Model&apos; module covers entities for models, assumptions, parameters, data, software and all the processes that transform these, including model execution and data transformation.</dc:description>
        <terms:license>http://creativecommons.org/publicdomain/zero/1.0/</terms:license>
        <terms:title>Open Energy Ontology (Modelling module)</terms:title>
    </owl:Ontology>
    


