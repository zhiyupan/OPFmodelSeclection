    <owl:Ontology rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-shared-axioms">
        <owl:versionIRI rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-shared-axioms.omn"/>
        <owl:imports rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-model.omn"/>
        <owl:imports rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-physical.omn"/>
        <owl:imports rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-sector.omn"/>
        <owl:imports rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-social.omn"/>
        <dc:description>The Open Energy Ontology is an ontology for all aspects of the energy modelling domain. The &quot;oeo-shared-axioms&quot; module covers axioms that connect classes from more than one thematic module.</dc:description>
        <dc:license>http://creativecommons.org/publicdomain/zero/1.0/</dc:license>
        <terms:title>Open Energy Ontology (Shared axioms module)</terms:title>
    </owl:Ontology>
    


