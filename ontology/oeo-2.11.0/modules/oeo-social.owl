    <owl:Ontology rdf:about="https://openenergyplatform.org/ontology/oeo/oeo-social/">
        <owl:versionIRI rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-social.omn"/>
        <owl:imports rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.11.0/oeo-shared.omn"/>
        <dc:description>The Open Energy Ontology is an ontology for all aspects of the energy modelling domain. The &apos;Social&apos; module covers entities that relate to people and the social, organisational and economic environment in which energy is produced and consumed, including sector, organisation, and various roles.</dc:description>
        <terms:license>http://creativecommons.org/publicdomain/zero/1.0/</terms:license>
        <terms:title>Open Energy Ontology (social module)</terms:title>
    </owl:Ontology>
    


