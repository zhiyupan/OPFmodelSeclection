        <obo:IAO_0000115 xml:lang="en">An economic instrument is a policy instrument that creates monetary (price) incentives to stimulate transformative measures.</obo:IAO_0000115>
        <obo:IAO_0000600 xml:lang="en">Examples: subsidies for installation of renewable energy technologies, tradable permits</obo:IAO_0000600>
        <rdfs:label xml:lang="en">economic instrument</rdfs:label>
