        <rdfs:label xml:lang="en">output data</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020352 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020352">
        <rdfs:comment xml:lang="en">A model is a continuant to represent a system and its behaviours in a simplified or idealised way.</rdfs:comment>
        <rdfs:label xml:lang="en">model</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00030029 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00030029">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000143"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
