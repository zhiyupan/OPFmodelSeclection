<!-- https://openenergyplatform.org/ontology/oeo/OEO_00000104 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000104">
        <rdfs:comment xml:lang="en">A constraint is a condition that has to be fulfilled within a calculation.</rdfs:comment>
        <rdfs:label xml:lang="en">constraint</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000143 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000143">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000144"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A grid is linked to grid components with BFO has part; this is the semantic replacement for hasComponent.</rdfs:comment>
        <rdfs:comment xml:lang="en">An electricity grid is a supply grid that transfers electrical energy / electricity.</rdfs:comment>
        <rdfs:label xml:lang="en">electricity grid</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000144 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000144">
        <rdfs:comment xml:lang="en">An electricity grid component is a grid component that is part of an electricity grid.</rdfs:comment>
        <rdfs:label xml:lang="en">electricity grid component</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000304 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000304">
        <rdfs:comment xml:lang="en">An objective function is an information content entity stating the function that should be maximised or minimised to solve a problem.</rdfs:comment>
        <rdfs:label xml:lang="en">objective function</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000313 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000313">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000314"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00140093"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00030029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00140094"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00030030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An optimisation is a model calculation with the goal to find a best choice or result for at least one variable or function in the model.</rdfs:comment>
        <rdfs:comment>An optimisation process has endogenous output data.</rdfs:comment>
        <rdfs:comment>An optimisation process has exogenous input data.</rdfs:comment>
        <rdfs:comment>The optimisation model participates in the optimisation process.</rdfs:comment>
        <rdfs:label xml:lang="en">optimisation</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000314 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000314">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000512"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000304"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000517"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An optimisation model has constraints.</rdfs:comment>
        <rdfs:comment xml:lang="en">An optimisation model is a model that optimises a target function.</rdfs:comment>
        <rdfs:comment>Use OEO has objective function instead of generic has part.</rdfs:comment>
        <rdfs:label xml:lang="en">optimisation model</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010490 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010490">
        <rdfs:comment xml:lang="en">A physical unit is a unit that represents a standardised quantity value of a physical quantifiable entity.</rdfs:comment>
        <rdfs:label xml:lang="en">physical unit</rdfs:label>
    </owl:Class>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020013 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020013">
