                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Endogenous data is a data item whose quantity value is determined by a model.</rdfs:comment>
        <rdfs:comment>Optimisation output data can be part of an IAO data set.</rdfs:comment>
        <rdfs:label xml:lang="en">endogenous data</rdfs:label>
    </owl:Class>
    

