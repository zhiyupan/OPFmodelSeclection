                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000144"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
