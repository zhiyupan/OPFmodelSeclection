<!-- BEGIN OPFModelFeature taxonomy generated by notebook -->
<!--
Generated OPFModelFeature taxonomy.
OPFModelFeature is a subclass of UserRequirement.
-->
<owl:Class rdf:about="#UserRequirement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label>User Requirement</rdfs:label>
  <rdfs:comment>Root class for user requirement taxonomy used in OPF model recommendation.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#OPFModelFeature">
  <rdfs:subClassOf rdf:resource="#UserRequirement"/>
  <rdfs:label>OPF Model Feature</rdfs:label>
  <rdfs:comment>Feature taxonomy used to describe OPF model characteristics inferred from user requirements.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#PowerFlowFormulationFeature">
  <rdfs:subClassOf rdf:resource="#OPFModelFeature"/>
  <rdfs:label>Power Flow Formulation Feature</rdfs:label>
  <rdfs:comment>How power-flow equations and grid physical relations are represented.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#ACOPF">
  <rdfs:subClassOf rdf:resource="#PowerFlowFormulationFeature"/>
  <rdfs:label>ACOPF</rdfs:label>
  <rdfs:comment>Full AC optimal power flow model considering P, Q, voltage magnitude, voltage angle, and nonlinear AC power-flow relations.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#DCOPF">
  <rdfs:subClassOf rdf:resource="#PowerFlowFormulationFeature"/>
  <rdfs:label>DCOPF</rdfs:label>
  <rdfs:comment>Linear approximation of ACOPF that ignores reactive power, voltage magnitude variation, and part of loss effects.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#LinearizedACOPF">
  <rdfs:subClassOf rdf:resource="#PowerFlowFormulationFeature"/>
  <rdfs:label>Linearized ACOPF</rdfs:label>
  <rdfs:comment>Linearized AC power-flow model preserving more AC physical relations than DCOPF.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#UnbalancedThreePhaseOPF">
  <rdfs:subClassOf rdf:resource="#PowerFlowFormulationFeature"/>
  <rdfs:label>Unbalanced Three-Phase OPF</rdfs:label>
  <rdfs:comment>Three-phase unbalanced OPF explicitly modeling A/B/C phase imbalance relations.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#HybridACDCOPF">
  <rdfs:subClassOf rdf:resource="#PowerFlowFormulationFeature"/>
  <rdfs:label>Hybrid AC/DC OPF</rdfs:label>
  <rdfs:comment>Hybrid AC/DC OPF modeling AC networks, DC networks, and AC/DC converter coupling relations.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#TemporalModeling">
  <rdfs:subClassOf rdf:resource="#OPFModelFeature"/>
  <rdfs:label>Temporal Modeling</rdfs:label>
  <rdfs:comment>Temporal modeling features including time coupling, time resolution, and optimization horizon.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#TimeHorizonFeature">
  <rdfs:subClassOf rdf:resource="#TemporalModeling"/>
  <rdfs:label>Time Horizon Feature</rdfs:label>
  <rdfs:comment>Whether the OPF model considers temporal coupling.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#StaticOPF">
  <rdfs:subClassOf rdf:resource="#TimeHorizonFeature"/>
  <rdfs:label>Static OPF</rdfs:label>
  <rdfs:comment>Single-time-step optimization without inter-temporal coupling.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#RealTimeOPF">
  <rdfs:subClassOf rdf:resource="#TimeHorizonFeature"/>
  <rdfs:label>Real-Time OPF</rdfs:label>
  <rdfs:comment>OPF for real-time operation using the latest system state.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#RollingHorizonOPF">
  <rdfs:subClassOf rdf:resource="#TimeHorizonFeature"/>
  <rdfs:label>Rolling Horizon OPF</rdfs:label>
  <rdfs:comment>Rolling-horizon optimization that repeatedly solves a moving time window.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#MultiPeriodOPF">
  <rdfs:subClassOf rdf:resource="#TimeHorizonFeature"/>
  <rdfs:label>Multi-Period OPF</rdfs:label>
  <rdfs:comment>Joint multi-period optimization considering ramping, storage SOC, and inter-temporal energy constraints.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#DynamicOPF">
  <rdfs:subClassOf rdf:resource="#TimeHorizonFeature"/>
  <rdfs:label>Dynamic OPF</rdfs:label>
  <rdfs:comment>Dynamic OPF emphasizing operating consistency over a longer horizon or dynamic process.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#TemporalResolution">
  <rdfs:subClassOf rdf:resource="#TemporalModeling"/>
  <rdfs:label>Temporal Resolution</rdfs:label>
  <rdfs:comment>Time resolution or time-step length used by the OPF model.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#OneMinuteResolution">
  <rdfs:subClassOf rdf:resource="#TemporalResolution"/>
  <rdfs:label>One-Minute Resolution</rdfs:label>
  <rdfs:comment>One-minute temporal resolution.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#FiveMinuteResolution">
  <rdfs:subClassOf rdf:resource="#TemporalResolution"/>
  <rdfs:label>Five-Minute Resolution</rdfs:label>
  <rdfs:comment>Five-minute temporal resolution.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#FifteenMinuteResolution">
  <rdfs:subClassOf rdf:resource="#TemporalResolution"/>
  <rdfs:label>Fifteen-Minute Resolution</rdfs:label>
  <rdfs:comment>Fifteen-minute temporal resolution.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#OneHourResolution">
  <rdfs:subClassOf rdf:resource="#TemporalResolution"/>
  <rdfs:label>One-Hour Resolution</rdfs:label>
  <rdfs:comment>One-hour temporal resolution.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#OptimizationHorizon">
  <rdfs:subClassOf rdf:resource="#TemporalModeling"/>
  <rdfs:label>Optimization Horizon</rdfs:label>
  <rdfs:comment>Total time span covered by one optimization run.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#ShortTermOptimizationHorizon">
  <rdfs:subClassOf rdf:resource="#OptimizationHorizon"/>
  <rdfs:label>Short-Term Optimization Horizon</rdfs:label>
  <rdfs:comment>Short optimization horizon, such as several minutes to one hour.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#DailyOptimizationHorizon">
  <rdfs:subClassOf rdf:resource="#OptimizationHorizon"/>
  <rdfs:label>Daily Optimization Horizon</rdfs:label>
  <rdfs:comment>Intra-day or 24-hour optimization horizon.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#WeeklyOptimizationHorizon">
  <rdfs:subClassOf rdf:resource="#OptimizationHorizon"/>
  <rdfs:label>Weekly Optimization Horizon</rdfs:label>
  <rdfs:comment>Weekly optimization horizon.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#LongTermOptimizationHorizon">
  <rdfs:subClassOf rdf:resource="#OptimizationHorizon"/>
  <rdfs:label>Long-Term Optimization Horizon</rdfs:label>
  <rdfs:comment>Long optimization horizon, such as multiple weeks, monthly, or longer time scales.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#UncertaintyHandlingFeature">
  <rdfs:subClassOf rdf:resource="#OPFModelFeature"/>
  <rdfs:label>Uncertainty Handling Feature</rdfs:label>
  <rdfs:comment>How OPF handles uncertainty from load, renewables, forecast errors, or contingencies.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#DeterministicOPF">
  <rdfs:subClassOf rdf:resource="#UncertaintyHandlingFeature"/>
  <rdfs:label>Deterministic OPF</rdfs:label>
  <rdfs:comment>OPF assuming deterministic input data.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#StochasticOPF">
  <rdfs:subClassOf rdf:resource="#UncertaintyHandlingFeature"/>
  <rdfs:label>Stochastic OPF</rdfs:label>
  <rdfs:comment>OPF considering random variables, probability information, or stochastic inputs.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#ChanceConstrainedOPF">
  <rdfs:subClassOf rdf:resource="#UncertaintyHandlingFeature"/>
  <rdfs:label>Chance-Constrained OPF</rdfs:label>
  <rdfs:comment>OPF requiring constraints to be satisfied at a specified probability level.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#RobustOPF">
  <rdfs:subClassOf rdf:resource="#UncertaintyHandlingFeature"/>
  <rdfs:label>Robust OPF</rdfs:label>
  <rdfs:comment>OPF requiring feasibility or security under worst-case uncertainty.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#PowerSystemDomainFeature">
  <rdfs:subClassOf rdf:resource="#OPFModelFeature"/>
  <rdfs:label>Power System Domain Feature</rdfs:label>
  <rdfs:comment>Power-system domain where the OPF model is mainly applied.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#TransmissionGridOPF">
  <rdfs:subClassOf rdf:resource="#PowerSystemDomainFeature"/>
  <rdfs:label>Transmission Grid OPF</rdfs:label>
  <rdfs:comment>OPF for transmission grids.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#DistributionGridOPF">
  <rdfs:subClassOf rdf:resource="#PowerSystemDomainFeature"/>
  <rdfs:label>Distribution Grid OPF</rdfs:label>
  <rdfs:comment>OPF for distribution grids.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#MicrogridOPF">
  <rdfs:subClassOf rdf:resource="#PowerSystemDomainFeature"/>
  <rdfs:label>Microgrid OPF</rdfs:label>
  <rdfs:comment>OPF for microgrids.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#DCGridOPF">
  <rdfs:subClassOf rdf:resource="#PowerSystemDomainFeature"/>
  <rdfs:label>DC Grid OPF</rdfs:label>
  <rdfs:comment>OPF for DC grids.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#MTDCGridOPF">
  <rdfs:subClassOf rdf:resource="#PowerSystemDomainFeature"/>
  <rdfs:label>MTDC Grid OPF</rdfs:label>
  <rdfs:comment>OPF for multi-terminal DC grids.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#SolutionMethodEnhancementFeature">
  <rdfs:subClassOf rdf:resource="#OPFModelFeature"/>
  <rdfs:label>Solution Method Enhancement Feature</rdfs:label>
  <rdfs:comment>Relaxation, approximation, decomposition, acceleration, or learning-based method enhancements.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#ConvexRelaxationMethod">
  <rdfs:subClassOf rdf:resource="#SolutionMethodEnhancementFeature"/>
  <rdfs:label>Convex Relaxation Method</rdfs:label>
  <rdfs:comment>Convex relaxation method for OPF.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#SOCPRelaxation">
  <rdfs:subClassOf rdf:resource="#ConvexRelaxationMethod"/>
  <rdfs:label>SOCP Relaxation</rdfs:label>
  <rdfs:comment>Second-order cone programming relaxation method.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#SDPRelaxation">
  <rdfs:subClassOf rdf:resource="#ConvexRelaxationMethod"/>
  <rdfs:label>SDP Relaxation</rdfs:label>
  <rdfs:comment>Semidefinite programming relaxation method.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#QCRelaxation">
  <rdfs:subClassOf rdf:resource="#ConvexRelaxationMethod"/>
  <rdfs:label>QC Relaxation</rdfs:label>
  <rdfs:comment>Quadratic convex relaxation method.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#LinearApproximationMethod">
  <rdfs:subClassOf rdf:resource="#SolutionMethodEnhancementFeature"/>
  <rdfs:label>Linear Approximation Method</rdfs:label>
  <rdfs:comment>Linear approximation method for OPF.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="#LinearApproximation">
  <rdfs:subClassOf rdf:resource="#LinearApproximationMethod"/>
