<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/bochengxu/OPF_Ontology#"
     xml:base="http://www.semanticweb.org/bochengxu/OPF_Ontology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:oeo="https://openenergyplatform.org/ontology/oeo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:www="https://www.commoncoreontologies.org/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology"/>
    

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    

    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    

    <!-- http://purl.obolibrary.org/obo/BFO_0000050 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
        <rdfs:comment xml:lang="en">a core relation that holds between a part and its whole</rdfs:comment>
        <rdfs:label xml:lang="en">part of</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- http://purl.obolibrary.org/obo/BFO_0000051 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000051">
        <rdfs:comment xml:lang="en">a core relation that holds between a whole and its part</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- http://purl.obolibrary.org/obo/IAO_0000136 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000136">
        <rdfs:comment xml:lang="en">A (currently) primitive relation that relates an information artifact to an entity.</rdfs:comment>
        <rdfs:label xml:lang="en">is about</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- http://purl.obolibrary.org/obo/RO_0000057 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000057">
        <rdfs:comment xml:lang="en">a relation between a process and a continuant, in which the continuant is somehow involved in the process</rdfs:comment>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    

<!-- https://openenergyplatform.org/ontology/oeo/OEO_00000501 -->

    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000501">
        <rdfs:comment xml:lang="en">A relation that holds between a continuant c1 and a continuant c2, where c1 is required by c2 as input to work.</rdfs:comment>
        <rdfs:label xml:lang="en">is used by</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000512 -->

    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000512">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
        <rdfs:range rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000304"/>
        <rdfs:comment xml:lang="en">A relation that holds between an optimisation and its objective function.</rdfs:comment>
        <rdfs:comment>复用 OEO 已有属性：模型使用的目标函数 / Reused OEO object property for model objective functions.</rdfs:comment>
        <rdfs:label>has objective function</rdfs:label>
        <rdfs:label xml:lang="en">has objective function</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00000517 -->

    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000517">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
        <rdfs:range rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000104"/>
        <rdfs:comment xml:lang="en">A relation that holds between a transformation and the constraints it has to fulfil.</rdfs:comment>
        <rdfs:comment>复用 OEO 已有属性：模型使用的约束函数 / Reused OEO object property for model constraints.</rdfs:comment>
        <rdfs:label>has constraint</rdfs:label>
        <rdfs:label xml:lang="en">has constraint</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00040010 -->

    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00040010">
        <rdfs:comment xml:lang="en">A property that links a quantity value to a unit in which the quantity value has been expressed.</rdfs:comment>
        <rdfs:label xml:lang="en">has unit</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00140093 -->

    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00140093">
        <rdfs:comment xml:lang="en">p has information input c iff: p has input c, and c is an information content entity</rdfs:comment>
        <rdfs:label xml:lang="en">has information input</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00140094 -->

    <owl:ObjectProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00140094">
        <rdfs:comment xml:lang="en">p has information output c iff: p has output c, and c is an information content entity</rdfs:comment>
        <rdfs:label xml:lang="en">has information output</rdfs:label>
    </owl:ObjectProperty>
    

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    

<!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    

    <!-- http://purl.obolibrary.org/obo/IAO_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000100">
        <rdfs:comment xml:lang="en">A data item that is an aggregate of other data items of the same type that have something in common. Averages and distributions can be determined for data sets.</rdfs:comment>
        <rdfs:label xml:lang="en">data set</rdfs:label>
    </owl:Class>
    

