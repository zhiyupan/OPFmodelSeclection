</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasUncertaintyHandlingFeature">
  <rdfs:domain rdf:resource="#OPFModel"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
