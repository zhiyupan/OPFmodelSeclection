<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Data_driven_ACOPF_Physics_informed_Learning_Calibration">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data driven ACOPF Physics informed Learning Calibration</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data-driven AC Optimal Power Flow with Physics-informed Learning and Calibrations</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2024</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/SmartGridComm60555.2024.10738079</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Junfei Wang; Pirathayini Srikantha</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">York University</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generate ACOPF solutions using physics-informed deep learning and feasibility calibration.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Need for a more efficient and reliable ACOPF solver because ACOPF is nonconvex, NP-hard, and difficult to solve quickly in modern grids.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC optimal power flow on IEEE bus-14 and bus-118 benchmark systems.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a data-driven ACOPF model produce near-optimal solutions while improving feasibility without relying on traditional solvers?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal bus voltage magnitudes and phase angles, generator active/reactive power dispatch, and calibrated feasible ACOPF solutions.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two-stage physics-informed DNN prediction followed by iterative feasibility calibration.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-flow equations with complex bus injections and Y-bus network model.</hasPowerFlowFormulationFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator buses, load buses, voltage magnitude/phase angle limits, and line flow limits.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics-informed loss, cycle-consistency reconstruction, and Gauss-Seidel-style calibration with warm starts.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported 0.67% optimality gap on IEEE 14-bus and 0.15% on IEEE 118-bus; calibration converged on all 14-bus tests and 92.2% on 118-bus.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses active and reactive power demand at all buses as input.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total generation cost, with generator cost functions Cg(PGg) typically convex quadratic in active power generation.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator active/reactive limits; AC power-balance equations at each bus; voltage magnitude and phase-angle bounds; line apparent-power flow limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active and reactive demand PDi, QDi; generator outputs PGg, QGg; bus voltages |Vi|, ϕi; Y-bus admittance matrix; voltage and flow bounds; calibration stop threshold ρ and maximum epochs E.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A CNN predicts voltages and angles from demand; power-flow equations reconstruct generator outputs and demand; an iterative calibration loop updates load-bus voltages and generator injections until imbalance is below ρ or E is reached.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trained and tested on 100K MATPOWER-generated samples for IEEE 14-bus and 118-bus systems, using 80/20 split; compared against supervised learning and DeepOPF-V.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The proposed method achieved lower feasibility error and smaller optimality gaps than baselines, with strong convergence on both benchmark systems.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: improved feasibility with near-optimal solutions and no traditional solver in the prediction stage. Limitation: calibration did not converge for all 118-bus test cases.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Future work mentions robust learning under input uncertainties and unsupervised or semi-supervised learning without labeled ACOPF solver data.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#AlgorithmicLearningObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#PredictionLossMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#PhysicsInformedLossObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DeviceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorConventionalSourceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#VoltageAngleOperatingBoundaryConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
