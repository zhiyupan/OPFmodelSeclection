<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Scalable_Security_Constrained_Multi_Step_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scalable Security Constrained Multi Step OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scalable Solutions for Security-Constrained Optimal Power Flow With Multiple Time Steps</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2025</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TIA.2025.3532927</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hussein Sharadga; Javad Mohammadi; Constance Crozier; Kyri Baker</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Texas A&amp;M International University; University of Texas at Austin; Georgia Institute of Technology; University of Colorado Boulder</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve large-scale security-constrained optimal power flow with multiple time steps efficiently under strict time limits.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Large SCOPF instances contain millions of continuous/integer variables and nonlinear nonconvex constraints, making them difficult to solve within challenge time limits.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Security-constrained optimal power flow with multiple time steps, including AC power flow, contingencies, reserves, device switching, and ramping constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a decomposition-based hybrid solver scale multi-timestep SCOPF to very large grids while maintaining high-quality feasible solutions?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generation and consumption dispatch, device switching status, bus voltage angles, AC power-flow feasible operating point, and reserve allocations.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two-stage DC/AC decomposition with sequential optimization for large networks.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DC module uses linearized/MILP approximations; AC module solves full nonlinear AC power-flow equations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiple time steps; sequential stage-wise optimization for large horizons.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time-step based control horizon; exact interval length not specified.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Control horizon divided into stages for networks over 2000 buses.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contingency constraints included; no stochastic or robust uncertainty model stated.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Security-constrained AC OPF with reserves, ramping, device uptime/downtime, and switching constraints.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Problem reformulation, McCormick relaxation, slack variables, clique constraints, analytical derivatives, vectorization, and sequential bound updates.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Designed for scalability and strict time limits on very large instances.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consumption devices represented with bid blocks and power consumption bounds.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximize total market surplus z over device powers, bus voltage angles, and switching variables.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equality constraints G enforce power-balance and AC/DC network equations; inequality constraints H cover voltage limits, real/reactive power limits, reserves, ramping, switching, contingency, and device operation constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Device power pjt, bus voltage angle θit, switching status ujt, shunt conductance gshjt, branch flow limits smaxj, reserve factors σscrn, ramp-up Pru, ramp-down Prd, and mismatch penalty pit.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DC subproblem solved as MILP with Gurobi; AC subproblem solved as NLP with IPOPT; large cases use sequential stage-wise optimization and selective contingency inclusion.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluated on 300+ scenarios across 73 to 8316-bus networks from ARPA-E GO challenge datasets.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The approach achieved high scaled scores in most scenarios, with average scores around 0.983 on Scenario Set 3 and 0.9992 on Scenario Set 2, while meeting time limits.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: scalable, robust, high-quality solutions, full AC formulation. Limitation: solution quality varies by scenario and depends on available reserve abundance; large cases require sequential decomposition.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied to ARPA-E Grid Optimization Challenge 3 datasets and testing platform.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerLinearProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
