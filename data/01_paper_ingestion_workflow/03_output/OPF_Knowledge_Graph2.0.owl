<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Heuristic_GWO_Stochastic_Renewable_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heuristic GWO Stochastic Renewable OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heuristic Algorithm Based Optimal Power Flow Model Incorporating Stochastic Renewable Energy Sources</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2020</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/ACCESS.2020.3015473</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inam Ullah Khan; Nadeem Javaid; Kelum A. A. Gamage; C. James Taylor; Sobia Baig; Xiandong Ma</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lancaster University; COMSATS University Islamabad; University of Glasgow</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve OPF with stochastic wind and solar generation using a heuristic optimizer.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conventional OPF is non-linear and non-convex; renewable intermittency adds uncertainty and cost penalties.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal power flow with thermal generators, wind farms, and solar PV under uncertainty and security constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can grey wolf optimization efficiently solve stochastic renewable OPF and outperform benchmark heuristics?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generation dispatch, scheduled wind and solar power, generator reactive power, bus voltages, line flows, total cost, and emissions.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stochastic renewable generation with reserve and penalty costs; carbon-tax emission term.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-flow equality constraints with active and reactive balance equations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period steady-state OPF.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not specified.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single operating point / one dispatch interval.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weibull wind and lognormal solar PDFs with reserve and penalty cost modeling.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal, wind, and solar generation on IEEE-30 and IEEE-57 bus systems.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grey wolf optimization metaheuristic; compared with GA, PSO, CSA, ABC, SHADE-SF, and hybrids.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported faster convergence and lower total cost than benchmark algorithms in the studied cases.</hasModelPerformanceFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total operating cost: thermal fuel cost with valve-point effect, direct wind/solar costs, reserve and penalty costs; optionally add carbon-emission cost.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active and reactive power balance equations; generator active/reactive limits; generator-bus voltage limits; load-bus voltage limits; transmission line apparent-power limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal cost coefficients ai, bi, ci, gi, hi; wind/solar direct, reserve, penalty coefficients; Weibull k,c; lognormal λ,ψ; emission coefficients αi,βi,γi,ωi,µi; carbon tax Ct; bus voltages and line limits.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solved with GWO using up to 1000 iterations on modified IEEE-30 and IEEE-57 systems; MATPOWER used for power flow; compared against several heuristics and hybrids.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated through simulation case studies on IEEE-30 and IEEE-57 bus systems, including carbon-tax and renewable-uncertainty scenarios.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GWO achieved the best or near-best cost and convergence time in the reported scenarios, while keeping voltages and reactive powers within limits.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: handles non-convex constrained OPF with stochastic renewables and converges well. Limitation: results are case-study based and not guaranteed best for all OPF problems.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses Monte-Carlo-generated renewable distributions for scenario analysis.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerNonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EnvironmentalSustainabilityObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EmissionMinimizationObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DeviceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorConventionalSourceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableDEROutputConstraint"/>
