  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusReactivePowerInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineImpedanceParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchSetParameter"/>
