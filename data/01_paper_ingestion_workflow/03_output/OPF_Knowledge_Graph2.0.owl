<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Physics_Informed_Neural_Networks">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics Informed Neural Networks</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics-informed neural networks: A deep learning framework for solving forward and inverse problems involving nonlinear partial differential equations</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2019</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1016/j.jcp.2018.10.045</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M. Raissi, P. Perdikaris, G.E. Karniadakis</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brown University; University of Pennsylvania</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve forward and inverse problems governed by nonlinear partial differential equations using physics-informed neural networks.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exploit physical laws as inductive bias to improve learning in small-data regimes and avoid black-box limitations.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data-driven solution and discovery of nonlinear PDEs from noisy or sparse observations.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can deep neural networks be constrained by PDE physics to infer hidden states and identify governing parameters from limited data?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predicted spatio-temporal PDE solutions, including state fields such as u(t,x), h(t,x), velocity and pressure fields, and identified PDE parameters λ.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Continuous-time and discrete-time physics-informed neural network formulations.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses automatic differentiation to enforce PDE residuals at collocation points or Runge–Kutta stage equations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-step and multi-step time evolution; continuous-time and discrete-time formulations.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses sparse snapshots, initial/boundary data, and collocation points; discrete-time examples use large time steps.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trains on available snapshots and collocation points over the modeled time interval.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No explicit uncertainty quantification; mentions noisy data robustness only.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None; the paper addresses general nonlinear PDEs in fluids, quantum mechanics, reaction-diffusion, and shallow-water waves.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics-informed loss functions with automatic differentiation; implicit Runge–Kutta-based discrete-time formulation.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported accurate predictions with low relative L2 error and robust parameter identification under noisy data.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize mean squared error or sum of squared errors combining data mismatch and PDE residuals; in discrete time, match Runge–Kutta stage outputs and boundary/snapshot data.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enforce governing PDE residuals, initial conditions, boundary conditions, periodicity, divergence-free incompressibility, and Runge–Kutta stage relations.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neural-network weights and biases; PDE parameters λ; collocation points; initial/boundary data; Runge–Kutta coefficients aij, bj, cj; time step Δt; number of stages q.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses feed-forward neural networks with tanh activations, automatic differentiation, and L-BFGS; discrete-time models leverage implicit Runge–Kutta schemes.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on Schrödinger, Allen–Cahn, Navier–Stokes, KdV, and Burgers examples against spectral/finite-element reference solutions.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics-informed neural networks can recover accurate PDE solutions and identify unknown coefficients from sparse, noisy data.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: data-efficient, physics-constrained, robust to noise, handles forward and inverse problems. Limitations: collocation cost grows in higher dimensions; architecture and training sensitivity remain.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open-source code and datasets were provided on GitHub.</hasFurtherProperty>
  <hasSourceFilePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data/01_paper_ingestion_workflow/01_input/01_source_papers/PINN.pdf</hasSourceFilePath>
  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PINN.pdf</hasSourceFileName>

  <hasModeledTechnology rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010423"/>
  <oeo:OEO_00000505 rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000128"/>
</owl:NamedIndividual>
<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Predicting_AC_Optimal_Power_Flows">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predicting AC Optimal Power Flows</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predicting AC Optimal Power Flows: Combining Deep Learning and Lagrangian Dual Methods</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2020</hasPublicationYear>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ferdinando Fioretto; Terrence W.K. Mak; Pascal Van Hentenryck</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Georgia Institute of Technology; Syracuse University</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predict AC optimal power flow setpoints from load conditions using deep learning.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC-OPF is nonlinear, nonconvex, and repeatedly solved under changing conditions; faster accurate approximations are needed.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predict generator dispatch and bus voltage magnitudes for AC-OPF while respecting physical and engineering constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can deep learning approximate AC optimal power flow solutions accurately and feasibly by exploiting OPF structure and Lagrangian duality?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predicted generator active power setpoints and bus voltage magnitudes; in the extended model also voltage angles and reactive generation, with derived load flows.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deep neural network with constraint-violation penalties, hot-start inputs, and Lagrangian dual multiplier updates.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power flow equations with Ohm’s law, line flow limits, and Kirchhoff current balance.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period, repeated operational snapshots; hot-start from a related prior state.</hasTimeHorizonFeature>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses hot-start states and evaluates on load variations; no explicit stochastic optimization.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transmission-network AC-OPF on IEEE and NESTA benchmark systems.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Violation-based Lagrangian relaxation with subgradient updates and hot-start weight reuse.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported high prediction accuracy and large runtime speedups over AC-OPF and DC approximation.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inputs are active and reactive load demands; no explicit demand response or flexible load modeling.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize squared prediction error for voltage magnitude, voltage angle, active generation, and reactive generation, plus weighted constraint-violation penalties.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage magnitude bounds, angle-difference bounds, generator active/reactive limits, line apparent-power limits, AC power-flow equations, and nodal active/reactive power balance.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load demands pd, qd; hot-start state pd0, qd0, pg0, qg0, v0, θ0; admittance entries gij, bij; bounds on v, θ, pg, qg, and line limits Sfmax; Lagrangian multipliers λc.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trained feed-forward ReLU subnetworks for v, θ, pg, qg using SGD/Adam and subgradient updates of Lagrangian multipliers.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on NESTA IEEE 14, 30, 39, 57, 73, 89, 118, 162, 189, and 300-bus cases with 80/20 splits.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constraint-aware and hot-start models improved prediction accuracy; the full Lagrangian-dual model was most accurate and fastest.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: very accurate and much faster than AC-OPF/DC-OPF. Limitation: relies on similar historical/hot-start states and benchmark-sized training data.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper also evaluates load-flow feasibility restoration and dispatch-cost closeness to AC-OPF solutions.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#AlgorithmicLearningObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#PredictionLossMinimizationObjective"/>
