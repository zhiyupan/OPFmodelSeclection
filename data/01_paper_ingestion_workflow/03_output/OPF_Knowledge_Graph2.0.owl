  <rdfs:domain rdf:resource="#OPFModel"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label>hasOptimizationHorizon</rdfs:label>
  <rdfs:comment>优化时域 / 一次优化覆盖的总时长 / Readable optimization horizon covered by one optimization run, e.g. 24 h, 1 day, 1 week.</rdfs:comment>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasUncertaintyHandlingFeature">
  <rdfs:domain rdf:resource="#OPFModel"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
