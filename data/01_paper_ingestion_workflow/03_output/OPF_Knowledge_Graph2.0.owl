<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#GridFM_v0">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GridFM v0</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Foundation models for the electric power grid</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2024</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1016/j.joule.2024.11.002</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hendrik F. Hamann; Blazhe Gjorgiev; Thomas Brunschwiler; Leonardo S.A. Martins; Alban Puech; Anna Varbella; Jonas Weiss; Juan Bernabe-Moreno; Alexandre Blondin Masse; Seong Lok Choi; Ian Foster; Bri-Mathias Hodge; Rishabh Jain; Kibaek Kim; Vincent Mai; François Miralles; Martin De Montigny; Octavio Ramos-Leanos; Hussein Suprême; Le Xie; El-Nasser S. Youssef; Arnaud Zinflou; Alexander Belyi; Ricardo J. Bessa; Bishnu Prasad Bhattarai; Johannes Schmude; Stanislav Sobolevsky</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IBM Research; IBM Research - Europe; Equilibrium Energy, Inc.; ETH Zürich; EPFL; National Renewable Energy Laboratory; Argonne National Laboratory; U.S. Department of Energy; INESC TEC; Harvard University; Hydro-Québec; University of Chicago; University of Colorado; New York University; Masaryk University</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To advocate and outline grid foundation models for power-system operations, planning, and control.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Increasing grid complexity and uncertainty from the energy transition, climate change, aging infrastructure, and cybersecurity threats.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lack of scalable, transferable AI methods for diverse power-grid tasks and power-flow-related applications.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can foundation models be developed for electric power grids to generalize across grid data and accelerate downstream applications such as power flow and OPF?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No OPF model is solved in this paper; it proposes a GridFM-v0 concept for reconstructing power-flow states and, in discussed downstream use, optimal generation dispatch and objective values.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graph neural network-based foundation model concept; masked autoencoder pre-training on graph-structured grid data.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power flow reconstruction on graph nodes with bus variables and line/transformer edges.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Initially single-time-step power-flow data; extendable to multiple consecutive time steps for forecasting.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single time step in the near-term model; high-resolution PMU data mentioned for dynamic extensions.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not specified; near-term focus is static power-flow applications.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses diverse topologies, load conditions, perturbations, and synthetic scenarios; discusses scenario trees and stochastic programming.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transmission and distribution grid applications including power flow, OPF, contingency analysis, state estimation, stability, control, planning, and cybersecurity.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Self-supervised masked graph autoencoding with physics-informed loss; intended to speed up power-flow-related computation.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Projected 3–4 orders-of-magnitude speed-up over conventional power-flow solvers; less than 1% error cited from related GNN work.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mentions load conditions, load forecasting, electric vehicles, heating electrification, and demand uncertainty.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For OPF use, minimize generation costs by reconstructing generator power; the paper does not present a full OPF mathematical formulation.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reconstructed node variables must satisfy power-flow equations and bounds such as generator capacity constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus active power, reactive power, voltage magnitude, voltage angle; line and transformer connectivity; topology, load conditions, and power-flow solutions.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GridFM-v0 is proposed as a masked graph autoencoder pre-trained on solved power-flow cases from multiple topologies and load conditions, then fine-tuned for downstream tasks.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No direct model validation results are reported for GridFM-v0; validation is proposed on open datasets and later on utility data behind firewalls.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper argues GridFMs could generalize across grid tasks and substantially accelerate power-system analysis, especially power-flow-related applications.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: scalability, adaptability, and simulation acceleration. Limitations: data availability, privacy, trust, and difficulty accessing operational grid data.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper is a perspective proposing a roadmap rather than presenting a completed OPF solver.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#UncertaintyScenarioAndRobustnessConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ProbabilisticRobustConstraint"/>
