<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Online_Optimization_in_Power_Systems">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Online Optimization in Power Systems</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Online Optimization in Power Systems With High Penetration of Renewable Generation: Advances and Prospects</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/JAS.2023.123126</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zhaojian Wang; Wei Wei; John Zhen Fu Pang; Feng Liu; Bo Yang; Xinping Guan; Shengwei Mei</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shanghai Jiao Tong University; Tsinghua University; Institute of High Performance Computing (A*STAR), Singapore</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review and compare online optimization techniques for power-system operation under high renewable penetration.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Increasing renewable variability and controllable loads make offline optimization less reliable for real-time power-system operation.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How to classify and apply online optimization methods to dynamic control, single-period OPF/voltage regulation, and multi-period energy management problems.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Which online optimization paradigms are most suitable for different power-system time scales and operational settings?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not applicable; this is a review paper rather than a solved OPF model.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review of optimization-guided dynamic control, feedback optimization, Lyapunov optimization, and online convex optimization.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discusses AC bus-injection and branch-flow models; linearized DC power flow and DistFlow approximations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Covers single-period and multi-period formulations, plus fast dynamic-control time scales.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seconds to minutes for dynamic control; single-period and multi-period decision settings.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period and multi-period; some Lyapunov examples use finite or infinite horizons.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Addresses renewable variability and uncertainty through online decision-making without relying on forecasts or historical distributions.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequency control, voltage regulation, OPF, economic dispatch, energy storage scheduling, demand response, and power markets.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compares feedback-based, primal-dual, ADMM, Newton-Raphson, Lyapunov, and OCO methods; discusses distributed and asynchronous variants.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emphasizes fast response, tracking of time-varying conditions, and reduced computational burden.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Includes controllable loads, demand response, electric vehicles, and load-side frequency control.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Examples include minimizing generation cost in OPF, regulation cost in frequency control, and long-term average cost in Lyapunov/OCO formulations.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power-flow equations, voltage limits, generation and reactive-power bounds, power-balance constraints, line congestion, storage SoC and charging/discharging limits, ramping and other coupled constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generation cost coefficients ai, bi; voltage bounds vi; power injection bounds Pi, Qi; line parameters rij, xij, Bij; storage queue/SoC Qt; Lyapunov weight ρ; stepsize η; control gains.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper reviews algorithmic frameworks and representative formulations; it does not present a single new solved OPF instance.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No dedicated validation of a new OPF model; cites prior experimental and numerical studies in the reviewed literature.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Online optimization is useful for volatile power systems because it can track changing conditions and avoid reliance on inaccurate forecasts.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: fast, measurement-driven, and suitable for time-varying systems. Limitations: problem-dependent, often lacks a unified theory, and some methods need communication or predictions.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper is a survey and taxonomy of online optimization methods in power systems.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityReliabilityObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TechnicalOperationPerformanceObjective"/>
