<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Multi_Period_Hybrid_AC_DC_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi Period Hybrid AC DC OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-Period Hybrid AC/DC-OPF Model for Flexibility Market Clearing With Seamless TSO-DSO Coordination</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/ACCESS.2023.3269423</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Damian Sieraszewski; Ole Kjærland Olsen; Dmytro Ivanko; Irina Oleinikova; Hossein Farahmand</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Department of Electric Power Engineering, Norwegian University of Science and Technology (NTNU); NORCE Norwegian Research Centre</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model flexibility market clearing and TSO-DSO coordination using a hybrid AC/DC optimal power flow formulation.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Need to unlock consumer-side flexibility and coordinate DSO and TSO operations to address congestion, voltage, and balancing challenges.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seamless coordination of transmission and distribution grid operation in a local flexibility market with multi-period flexibility procurement.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a multi-period hybrid AC/DC-OPF model accurately clear flexibility and coordinate TSO-DSO actions across transmission and distribution grids?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal day-ahead dispatch and flexibility market dispatch, including generation, flexible load, battery charging/discharging, load shedding, bus voltages, and line power flows.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid SOC-ACOPF for distribution grid and DC-OPF for transmission grid; multi-period formulation; AC-DC connection constraint.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SOC-ACOPF for distribution; DC-OPF for transmission; convex relaxation with auxiliary variables.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-period; hourly day-ahead plus quarter-hour flexibility intervals; rolling horizon in operation.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hourly and 15-minute time units.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 hours with quarter-hour subperiods.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scenario-based planning mentioned, but probabilistic scenarios are not developed in this paper.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TSO-DSO coordination in a local flexibility market with transmission and radial distribution grids.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyomo implementation solved with Gurobi; two-stage optimization for day-ahead and flexibility market clearing.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on standard test grids; reported high accuracy and applicability; compared with standalone AC and DC OPF.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flexible loads, load shifting, load shedding, distributed generation, and batteries.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total operating cost of transmission and distribution generation, flexibility activation, battery operation, and load shedding across all periods.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SOC-ACOPF power balance and conic relaxation constraints; AC-DC coupling constraint; DC power balance, line flow limits, slack angle; flexible generation/load bounds; zero-net load shifting; battery SoC, charge/discharge, and terminal SoC constraints; load shedding equals served load.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generation cost coefficients, flexibility prices, battery cost, load-shedding cost, network susceptance matrices, active/reactive load limits, generation limits, line flow limits, slack angle, battery SoC bounds, charge/discharge limits, efficiencies, and initial SoC.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Implemented in Python with Pyomo and solved using Gurobi on a 33-bus distribution grid and 9-bus transmission grid test case.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated against standalone SOC-ACOPF and DC-OPF results and tested on flexibility, voltage, and congestion cases.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flexibility reduced costs, improved voltages, lowered imported transmission power and distribution losses, and could also relieve transmission congestion.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: unified multi-period TSO-DSO coordination and flexibility clearing. Limitation: single-optimization formulation may become computationally heavy for multiple DSOs; reactive power flexibility not yet included.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Future work extends the model with ADMM for multiple DSOs and reactive power flexibility exchange.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecondOrderConeProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
