<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Day_Ahead_Real_Time_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Day Ahead Real Time OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Day-Ahead and Real Time Optimal Power Flow considering Renewable Energy Resources</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2016</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1016/j.ijepes.2016.03.033</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S. Surender Reddy; P.R. Bijwe</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Woosong University; Indian Institute of Technology Delhi</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To schedule generation economically while maintaining security in day-ahead and real-time OPF with renewable variability.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conventional DA-OPF and RT-OPF use static snapshots and ignore renewable/load variability within scheduling intervals.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal power flow for thermal-wind-solar systems with renewable variability, voltage, reactive power, line-flow, and ramp constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can participation factors evaluated once at the start of each interval capture intra-interval renewable variability without increasing optimization dimensionality?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generator dispatch schedules, renewable generation schedules, interval costs/profits, and voltage stability index values.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single optimization with 'best-fit' participation factors over sub-interval variability.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-flow equations with voltage magnitude/angle, reactive power, and line-flow constraints.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Day-ahead and real-time multi-interval scheduling with 15-min and 1-min sub-intervals.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RT-OPF: 1 min sub-intervals within 10-min intervals; DA-OPF: 15 min sub-sub-intervals within 1 h intervals.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RT-OPF over 60 min; DA-OPF over 24 h.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses forecasted solar, wind, and load variability within intervals; no explicit stochastic or robust formulation.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal generators with wind and solar PV injections, AGC participation factors, ramp limits, and voltage stability index.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluates 'best-fit' participation factors once to avoid separate optimization for every sub-interval.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported lower total cost and improved voltage stability versus conventional interval-by-interval OPF.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forecasted load demand varies within sub-intervals and is included in imbalance calculations.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total generation cost over RT sub-intervals; maximize total profit over DA intervals as revenue minus generation cost.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active and reactive nodal power balance, generator output limits with ramp-up/down limits, renewable output caps, bus-voltage limits, line-flow limits, and demand-supply balance constraint in DA-OPF.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator cost coefficients; energy price; wind and solar direct cost coefficients; bus admittance Gij/Bij; ramp limits; voltage and line-flow limits; forecasted load, wind, and solar outputs; participation factors.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATLAB Optimization Toolbox FMINCON was used on the IEEE 30-bus system with wind at bus 11 and solar PV at bus 13.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compared conventional and proposed RT-OPF/DA-OPF on IEEE 30-bus test system using 60-min RT and 24-h DA schedules.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The proposed approach reduced RT total cost and increased DA profit while keeping optimization size unchanged and improving voltage stability.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: captures intra-interval variability with little added computational burden. Limitation: relies on forecast availability and fixed participation factors within each interval.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage stability was assessed using the L-index/VSEI.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityReliabilityObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ProfitAndRevenueObjective"/>
