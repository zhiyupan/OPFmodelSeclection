<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Real_Time_Sequential_Security_Constrained_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Real Time Sequential Security Constrained OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Real-Time Sequential Security-Constrained Optimal Power Flow: A Hybrid Knowledge-Data-Driven Reinforcement Learning Approach</hasPaperTitle>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zhongkai Yi; Xue Wang; Cheng Yang; Chao Yang; Mengyang Niu; Wotao Yin</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alibaba DAMO Academy; Alibaba US; Tsinghua University; Harbin Institute of Technology</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve sequential real-time security-constrained optimal power flow with fast dispatch decisions under inaccurate environmental parameters.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACOPF is nonconvex, time-coupled by ramping limits, and difficult to solve quickly and safely when system parameters are inaccurate or contingencies are unexperienced.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sequential security-constrained AC optimal power flow for real-time operation with generator active/reactive dispatch and network security limits.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a hybrid knowledge-data-driven reinforcement learning method produce safe real-time OPF dispatches efficiently without relying on accurate environmental models?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Safe generator active and reactive power dispatch commands; resulting bus voltage magnitudes and branch active/reactive power flows within limits.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid knowledge-data-driven reinforcement learning with a safety-layer projection model and inactive-constraint identification.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-flow formulation with nonlinear nodal injections, branch flows, voltage magnitudes, and ramping-coupled generator limits.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sequential multi-step dispatch with future load forecasts and ramping-coupled time dependence.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Real-time operation over time slots; forecasting horizon T steps.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infinite-horizon sequential decision process terminated by grid failure/non-convergence.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses reinforcement learning for inaccurate environments and updates safety-layer parameters from latest measurements.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Security-constrained ACOPF with coordinated active and reactive power dispatch, voltage and branch-flow security limits.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved SAC with SAM, prioritized replay, adaptive entropy, hybrid safety layer, and inactive-constraint elimination.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Claims faster decision-making and reduced security violations with comparable economic performance.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Includes forecasted net load demand in the state; no explicit demand response control.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize cumulative generation operating cost, with quadratic cost coefficients for each generator over time.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-balance equations, branch active/reactive flow equations, generator active/reactive limits, branch flow limits, voltage magnitude limits, and ramping-coupled generator bounds; safety-layer projection also enforces linearized security constraints and power balance.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator cost coefficients; generator active/reactive bounds and ramping limits; bus voltages; line conductance/susceptance or resistance/reactance; branch flow limits; load demand and forecasted load; slack-bus limits; penalty coefficients; SAC temperature and learning rates.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sequential decisions are produced by an improved soft actor-critic policy, then projected by a linear security layer initialized from linearized power-flow knowledge and updated with data; inactive constraints are removed analytically.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on IEEE 30-bus and larger systems, including contingency and parameter-error scenarios, with comparisons against penalty, constrained-policy, and pure data-driven safety-layer baselines.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The method maintains voltages and branch flows within safe ranges, reduces violation times in early training and contingencies, and scales to larger systems with low decision time.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: safe real-time dispatch, better robustness to inaccurate models, and high computational efficiency. Limitation: safety layer uses linearized power-flow approximation and may need conservative limits to offset approximation error.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper also evaluates scalability on 9-, 30-, 57-, 118-, and 1187-bus systems.</hasFurtherProperty>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityReliabilityObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadSheddingMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ReliabilityObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DeviceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityStabilityAndReserveConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorConventionalSourceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
