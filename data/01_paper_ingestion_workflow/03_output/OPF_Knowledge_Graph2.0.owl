<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Chance_Constrained_Distributed_Confidentiality_Preserving">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chance Constrained Distributed Confidentiality Preserving</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chance-Constrained OPF: A Distributed Method With Confidentiality Preservation</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2022.3200941</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mengshuo Jia; Gabriela Hug; Yifan Su; Chen Shen</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ETH Zurich; Tsinghua University</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve multi-regional chance-constrained optimal power flow in a distributed way while preserving confidentiality of regional data.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Centralized CC-OPF requires sharing confidential generation costs, loads, topologies, and line parameters across regional ISOs.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Global chance-constrained OPF for a multi-regional interconnected grid with confidential regional information.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can CC-OPF be solved exactly in a distributed manner without revealing regional confidential data?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal dispatchable generation schedules across regions; implied bus voltage and line-flow constraint satisfaction through the solved CC-OPF.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed chance-constrained OPF with confidentiality-preserving transformations and privacy-preserving aggregation.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses decoupled linearized power flow to express voltages and line flows as linear functions of injections.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-time-slot formulation with inter-temporal ramp-rate constraints.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time slots; day-ahead dispatch in experiments with T = 24.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finite horizon over T time slots.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chance constraints with wind-power uncertainty modeled by Gaussian mixture distributions and quantile conversion.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-regional interconnected grid with dispatchable generators, wind farms, loads, nodal voltages, and line flows.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformation-based encryption, accelerated average consensus, and privacy-preserving average consensus.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Claims exact global optimal dispatch recovery, high accuracy, and no parameter tuning or convergence issues.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loads are included as fixed demand; load uncertainty is ignored.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total generation cost over all regions and time slots: sum of quadratic and linear dispatchable-generation costs.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Capacity bounds and ramp-rate limits on generators; chance-constrained supply-demand balance; chance-constrained state limits for voltages or line flows; deterministic linearized power-flow-based mappings.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quadratic and linear generator cost coefficients; generation upper/lower bounds; ramp-rate bounds; wind-power quantiles; state upper bounds; DLPF mapping coefficients; line admittance/topology data.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transforms the CC-OPF into a quadratic program, encrypts regional variables and coefficients with private matrices, computes coupled coefficients and aggregated constants via distributed consensus, then solves and decrypts locally.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tested on multiple benchmark systems from 39-bus to 1354-bus with 24 time slots; proposed method matched centralized benchmark with very small relative errors.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The method reproduces centralized optimal dispatch accurately, scales to larger systems, and outperforms compared obfuscation approaches in solution quality.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: exact optimality preservation, confidentiality preservation, no tuning, robust convergence. Limitation: relies on linearized power flow and is not directly full AC OPF; TE fails in a single-period single-generator global-balance case.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be extended to AGC-aware and joint-chance-constrained OPF problems.</hasFurtherProperty>
  <hasSourceFilePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data/01_paper_ingestion_workflow/01_input/01_source_papers/Chance-Constrained_OPF_A_Distributed_Method_With_Confidentiality_Preservation.pdf</hasSourceFilePath>
  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chance-Constrained_OPF_A_Distributed_Method_With_Confidentiality_Preservation.pdf</hasSourceFileName>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#QuadraticProgrammingProblem"/>
