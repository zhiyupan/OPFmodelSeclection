<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Demand_Response_AC_OPF_Flexible_Loads">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Demand Response AC OPF Flexible Loads</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal Scheduling of Demand Response-Based AC OPF by Smart Power Grid’ Flexible Loads Considering User Convenience, LSTM-Based Load Forecasting, and DERs Uncertainties</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2024</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/ACCESS.2024.3498598</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alireza Zarei; Navid Ghaffarzadeh; Farhad Shahnia; Miadreza Shafie-Khah</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imam Khomeini International University; Murdoch University; RMIT University</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Schedule demand response within AC optimal power flow for smart grids with flexible loads, renewables, and storage.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduce total system cost and peak demand while preserving user convenience and accommodating renewable and demand uncertainty.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-objective AC OPF with demand response, EV/HVAC aggregators, ESS, and renewable curtailment under network constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How can AC OPF coordinate demand response and flexible-load aggregators to lower cost and peaks without violating grid and comfort constraints?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generation dispatch, demand response schedule, EV charging/discharging schedule, HVAC power consumption schedule, bus voltage profile, line power flows, load shedding, and renewable curtailment.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-objective AC OPF coordinated with demand response, EV and HVAC aggregators, ESS, and renewable generation.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power flow with active/reactive balance, bus voltages, line flow limits, and transmission impedance equations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24-hour scheduling with hourly intervals.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hourly.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 h.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scenario-based renewable uncertainty and LSTM-based load forecasting; EV energy and travel distance modeled with normal distribution.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smart grid transmission network with thermal units, wind, solar, ESS, EVs, HVACs, and load shedding.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solved as MINLP in GAMS with CONOPT3; TOPSIS used to select the preferred DR step.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluated on modified IEEE 24-bus and IEEE 118-bus systems; reports cost, peak reduction, voltage variation, and execution time.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Demand response for large flexible loads plus aggregated EV and HVAC loads with comfort and participation limits.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total cost including generation cost, load shedding cost, and wind/solar curtailment cost; minimize voltage deviation; maximize DR revenue, peak reduction, and user convenience.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal unit active/reactive limits and ramping; load shedding bounds; ESS and EV charge/discharge and energy limits; wind/solar availability and curtailment; AC power balance and line flow limits; DR bounds and constant power-factor load shifting; HVAC temperature dynamics and comfort bounds.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fuel-cost coefficients bg,cg; VOLL, VOLW, VOLS; generator limits Pg/Qg and ramp rates; line susceptance b and impedance Zij; load baselines PL0, QL0; DR factor α; ESS/EV efficiencies and capacities; renewable availabilities wt, st; HVAC thermal coefficients k1–k4; temperature limits; LMP λ.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Formulated in GAMS as a mixed-integer nonlinear program and solved with CONOPT3; scenario results were weighted by probabilities and ranked with TOPSIS.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on IEEE 24-bus and 118-bus systems using 12 renewable scenarios and DR steps from 0% to 25%.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At 20% DR, the model achieved the best TOPSIS outcome, reducing total cost and peak demand while keeping voltages within limits.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: integrates AC OPF, DR, EV/HVAC aggregators, storage, and uncertainty. Limitation: aggregator placement was assumed, not optimized.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses both active and reactive demand response with user-convenience and comfort-aware flexible-load scheduling.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerNonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
