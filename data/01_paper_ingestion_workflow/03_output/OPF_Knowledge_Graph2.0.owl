<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Reserve_Constrained_AC_Power_Flow">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reserve Constrained AC Power Flow</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reserve Constrained AC Optimal Power Flow Using Accelerated Primal-Dual Interior Point Method</hasPaperTitle>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2025.3626450</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yehong Peng; Yong Fu</hasAuthor>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Co-optimize energy dispatch and operating reserve allocation in AC power system operation.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conventional reserve scheduling or simplified ED-based approaches neglect full AC network constraints and can cause infeasibility, voltage insecurity, congestion, and suboptimality.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period reserve-constrained AC optimal power flow with device energy/reserve co-optimization, AC network limits, and zonal reserve requirements.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How can reserve models be efficiently incorporated into AC OPF and solved accurately for large-scale systems?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generation and consumption dispatch, device reserve allocations, bus voltage magnitudes and angles, AC branch power flows, shunt steps, transformer tap ratios and phase shifts, and reserve shortfall amounts.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period nonlinear AC OPF with co-optimized energy and real/reactive reserve scheduling.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Full AC branch flow equations with voltage magnitudes/angles, transformer tap ratios, phase shifting, and shunt modeling.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period operating snapshot.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses predefined zonal reserve requirements; no explicit stochastic or robust uncertainty model.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Includes producing and consuming devices, real/reactive reserves, zonal reserve zones, shunts, transformers, and branch overload penalties.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accelerated primal-dual interior point method with symmetric Jacobian, Cholesky factorization, direct step-size update, and tailored initialization.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Designed for faster and more stable solution of large-scale RCOPF instances.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consuming devices participate in energy and reserve provision.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximize total market surplus: device consumption benefit minus generation cost, imbalance penalties, branch overload penalties, reserve offer costs, zonal reserve shortfall penalties, and reactive reserve costs.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equality constraints enforce device definitions, reserve cost definitions, AC branch flow equations, bus real/reactive power balances, and zonal reserve requirements; inequalities bound device outputs, reserve capabilities, voltage magnitudes, transformer settings, branch apparent flows, shunt steps, and reserve requirements.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Offer/bid block prices, imbalance penalty costs, branch overload penalty cost, reserve marginal costs, branch conductance/susceptance, shunt coefficients, device power limits, reserve capability limits, zonal reserve requirements and scaling factors, branch flow limits, voltage/tap/phase bounds.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solved by A-PDIPM using perturbed KKT conditions, symmetric Jacobian construction, pivoted Cholesky factorization, matrix reordering/scaling, direct feasibility-preserving step sizes, and problem-specific primal/dual initialization.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluated on 73-bus to 23,643-bus GO3-derived cases; compared with pre-reserve/post-reserve OPF and IPOPT.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RCOPF produced converged secure solutions and higher market surplus than simplified reserve allocation approaches; A-PDIPM reduced iterations and runtime, especially on large cases.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: accurate AC co-optimization with reserves and improved computational efficiency. Limitation: single-period formulation and some scenarios still allow reserve shortfalls when economically optimal.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Derived from DOE ARPA-E Grid Optimization Challenge 3 datasets.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
