<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Multi_Period_Storage_Sizing_Placement">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi Period Storage Sizing Placement</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sizing and Placement of Community Energy Storage Systems using Multi-Period Optimal Power Flow</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2021</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/PowerTech46648.2021.9494820</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marcel Böhringer; Soham Choudhury; Sebastian Weck; Jutta Hanson</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technical University of Darmstadt, Department of Electrical Power Supply with Integration of Renewable Energy (E5), Darmstadt, Germany</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Size and place community energy storage and photovoltaic systems in a low-voltage district using multi-period optimal power flow.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improve district self-sufficiency and reduce costs while respecting network constraints and PV/storage interactions.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal sizing of CES and PV, and optimal CES placement in a residential low-voltage network under cost scenarios and self-sufficiency constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How do PV sizing, CES sizing, feed-in tariffs, and self-sufficiency requirements affect optimal storage placement and district economics?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal PV installation size, optimal CES capacity, CES placement node, time-resolved grid import and export, and network losses.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-period OPF with sizing variables for PV and CES and placement analysis.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low-voltage network OPF with real and reactive power outputs, voltages, phase angles, and network constraints.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time-coupled multi-period formulation with inter-temporal storage energy balance.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15-minute periods</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Planning horizon over T periods; case study uses a day-resolved time series.</hasOptimizationHorizon>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Residential low-voltage CIGRÉ network with PV, community storage, grid import/export, and self-sufficiency constraints.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensioning strategy and receding-horizon placement strategy.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Placement mode minimizes network losses; sizing mode is cost-optimized.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Household load profiles are included and self-sufficiency limits grid import from community demand.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total imported-energy cost minus export revenue over time, plus amortized CES capacity cost and PV investment cost.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CES energy balance, state-of-charge bounds, charge/discharge power limits, PV generation limits from irradiation and efficiency, self-sufficiency lower bound on grid import, and standard OPF network constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grid import/export prices, CES CAPEX/OPEX, PV CAPEX/OPEX, interest rate, operating life, charging/discharging efficiencies, PV efficiency, irradiation profiles, household load profiles, and self-sufficiency rate.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Implemented in MATLAB R2019b with MATPOWER 7.0; MP-OPF adapted with added variables and constraints for the LV-CIGRÉ test grid.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on the CIGRÉ low-voltage residential subnetwork using synthetic load profiles, PV irradiation profiles, and three cost scenarios.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High feed-in tariffs favor maximum PV and no CES; lower costs favor larger CES and smaller PV; optimal CES placement shifts with self-sufficiency level toward central low-impedance nodes.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Captures time-coupled storage and placement effects in LV grids, but omits seasonal variation, heat pumps, EVs, and alternative storage technologies.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses self-sufficiency rate to progressively exclude grid-supplied households from CES placement consideration.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerLinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
