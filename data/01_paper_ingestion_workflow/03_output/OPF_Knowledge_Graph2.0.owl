  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unbalanced_Three-Phase_Optimal_Power_Flow_for_Smart_Grids.pdf</hasSourceFileName>

  <hasModeledTechnology rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010423"/>
