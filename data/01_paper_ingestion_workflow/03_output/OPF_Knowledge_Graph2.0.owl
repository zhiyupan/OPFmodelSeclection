<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#DeepOPF_V">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepOPF V</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepOPF-V: Solving AC-OPF Problems Efficiently</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2022</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2021.3114092</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wanjun Huang; Xiang Pan; Minghua Chen; Steven H. Low</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">City University of Hong Kong; Chinese University of Hong Kong; Caltech; University of Melbourne</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve AC-OPF problems efficiently using a deep neural network-based voltage-constrained approach.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC-OPF must be solved more frequently for stable, economic operation under increasing renewable and load uncertainty, so faster feasible solutions are needed.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard AC optimal power flow with nonlinear power balance equations and operational limits.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can AC-OPF be solved much faster while preserving feasibility by predicting voltages directly and reconstructing remaining variables without solving nonlinear power flow equations?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generation dispatch, bus voltage magnitudes and angles, branch power flows, and load satisfaction levels.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNN predicts all bus voltages; remaining variables are reconstructed from power-flow equations; post-processing adjusts voltages to improve feasibility.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard AC power flow equations with active/reactive balance, voltage magnitude/angle, generator, and branch flow limits.</hasPowerFlowFormulationFeature>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The AC-OPF formulation is deterministic; randomly sampled and correlated load scenarios are used only to generate training and test data.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC-OPF on IEEE 118/300-bus systems and a 2000-bus test system.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage prediction plus direct reconstruction and linearized post-processing for constraint repair.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported up to four orders of magnitude speedup with comparable optimality gap and preserved feasibility.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load satisfaction is evaluated; unsatisfied loads may be compensated by controllable distributed energy sources such as batteries.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total active generation cost, sum of Ci(Pgi) over generator buses.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enforces AC power balance for active and reactive injections, generator active/reactive limits, bus voltage magnitude bounds, branch apparent power limits, and phase-angle difference bounds.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pgi, Qgi, Pdi, Qdi, Vi, θi, gij, bij, Pij, Qij, Smax_ij, and bus/line sets N, NG, E; predicted voltages and loads are used to reconstruct remaining variables.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two DNNs predict voltage magnitudes and angles from loads; power-flow equations then compute generation and auxiliary variables; a post-processing step linearizes inequality violations to adjust voltages.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on modified IEEE 118/300-bus systems and a 2000-bus test system using MIPS-generated ground truth; compared with DACOPF and EACOPF.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepOPF-V achieved negligible optimality loss, high constraint satisfaction, and speedups up to about four orders of magnitude; voltage and power-balance feasibility were preserved.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: very fast, feasible voltage prediction, automatic satisfaction of power-flow equalities. Limitations: post-processing cannot guarantee all inequality constraints, and some load mismatch may remain.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses fully connected neural networks with ReLU and Adam; large systems can be split into bus groups for parallel voltage prediction.</hasFurtherProperty>
  <hasSourceFilePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data/01_paper_ingestion_workflow/01_input/01_source_papers/DeepOPF-V_Solving_AC-OPF_Problems_Efficiently.pdf</hasSourceFilePath>
  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepOPF-V_Solving_AC-OPF_Problems_Efficiently.pdf</hasSourceFileName>
