<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Convex_DistFlow_Loss_Reduction">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Convex DistFlow Loss Reduction</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss reduction in a windfarm participating in primary voltage control using an extension of the Convex DistFlow OPF</hasPaperTitle>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Benoît Martin; Philippe De Rua; Emmanuel De Jaeger; François Glineur</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Université Catholique de Louvain (UCL), MEED/iMMC and CORE/ICTEAM</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal reactive dispatch in a wind farm to reduce collector-grid losses while providing primary voltage control.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Current reactive power setpoint dispatch among wind turbines and switchable capacitor/inductor banks is suboptimal and causes extra energy losses.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPF for a radial wind-farm collector grid with transformers, line charging, OLTC, and discrete capacitor/inductor bank switching.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can an extended convex DistFlow OPF accurately and efficiently determine OLTC tap and reactive dispatch under primary voltage control?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal OLTC tap selection, reactive power dispatch of wind turbines and static units, bus voltages, branch power flows, and minimized active power losses.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extended convex DistFlow with discrete OLTC and static bank switching; formulated as MISOCP and relaxed by linear outer approximation.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Convex DistFlow with π-line model, variable-ratio transformers, SOC relaxation, and convexified voltage-drop equations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single operating point; repeated over many operating conditions.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10 min data used for yearly clustering; model itself is static per case.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period OPF per operating condition.</hasOptimizationHorizon>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radial wind-farm collector grid with DFIG turbines, capacitive cables, OLTC transformer, and switchable capacitor/inductor banks.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linear outer approximation of SOC constraints using Ben-Tal–Nemirovski BTN relaxation.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compared with Matpower; accuracy assessed by relaxation error and PF feasibility; faster for some cases but slower at higher BTN degree.</hasModelPerformanceFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize active power exchange at the PCC, representing collector-grid losses, plus a penalty on reactive mismatch with the PCC setpoint.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active/reactive nodal balances; branch loss and voltage-drop equations; thermal limits; WT capability curve; voltage bounds; angle-difference limits; PCC balance and voltage; reactive mismatch disjunction; single-choice OLTC tap and bank state constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Branch impedances and charging susceptances; transformer tap ratios and series elements; voltage bounds; thermal limits; WT reactive capability limits; PCC voltage and reactive setpoint; big-M constants; OLTC tap count; bank state count; mismatch penalty weight.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solved as a MISOCP and further as a MILP via BTN outer approximation; validated by running Matpower power flows on the obtained setpoints; compared against Matpower MIPS over 147 discrete configurations and clustered yearly operating points.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relaxation accuracy tested on six extreme operating cases and feasibility checked with Matpower PF; results compared against exact Matpower-based OPF across many clustered timesteps.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relaxed model is often accurate when no reactive mismatch is expected, can outperform Matpower on a significant fraction of cases, and may be faster for moderate BTN degree.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: handles OLTC, shunt elements, and discrete banks in a convex framework; can be made arbitrarily accurate by increasing BTN degree. Limitation: accuracy degrades when loss minimization conflicts with reactive-setpoint tracking.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper studies a radial 78 MW wind farm with 39 DFIG turbines, 21 OLTC taps, and 7 static-unit states.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerNonlinearProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerQuadraticProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecondOrderConeProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TechnicalOperationPerformanceObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkLossMinimizationObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DeviceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowDistFlowPhysicsConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
