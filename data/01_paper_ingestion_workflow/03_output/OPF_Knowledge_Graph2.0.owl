<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Frequency_Constrained_Dispatch">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequency Constrained Dispatch</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Deep Neural Network-based Frequency Predictor for Frequency-Constrained Optimal Power Flow</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2025</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/IAS62731.2025.11061730</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fan Jiang; Xingpeng Li; Pascal Van Hentenryck</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">University of Houston; Georgia Institute of Technology</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Real-time frequency-constrained optimal power flow with DNN-based RoCoF and frequency nadir constraints.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accurate RoCoF and frequency nadir constraints are complex to compute, yet needed for fast real-time FCOPF.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Traditional OPF lacks frequency security; linearized FCOPF can be inaccurate for RoCoF and frequency nadir.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a DNN predictor replace simplified frequency constraints in FCOPF while improving accuracy and maintaining solvability?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generator dispatch with associated RoCoF and frequency nadir values under contingencies.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FCOPF augmented with a DNN-based frequency predictor and mixed-integer linearized ReLU constraints.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DC power flow with nodal balance, line flow equations, generator limits, and thermal limits.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period real-time dispatch; no multi-period horizon.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Real-time OPF, described as run about every 5 minutes.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single operating snapshot.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scenario-based EMT training data across varying loads, generator outputs, and outage locations; no explicit stochastic optimization.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequency security constraints for low-inertia grids using RoCoF and frequency nadir.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNN predictor linearized with mixed-integer constraints and solved with Gurobi.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compared solve time and frequency-metric accuracy against T-OPF and linear FCOPF.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load variations are included as scenario inputs; no explicit demand response or load control.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total generation cost using quadratic generator cost functions, sum_i(c2_i Pg_i^2 + c1_i Pg_i + c0_i).</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nodal power balance, DC line flow equations, generator output bounds, transmission line thermal limits, and frequency constraints on RoCoF and frequency nadir.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator cost coefficients c2_i, c1_i, c0_i; line reactance x_k; generator and line limits; system inertia H_sys; base power P_base; base frequency f0; RoCoF and frequency thresholds; DNN weights, biases, and ReLU bounds.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Implemented in Python 3.9 with Gurobi; DNN trained on PSCAD/EMTDC simulation data and embedded as mixed-integer linear constraints.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated against PSCAD/EMTDC simulations on a modified IEEE 9-bus system under normal and high-load contingencies.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNN-FCOPF produced frequency metrics much closer to EMT simulations than linear FCOPF, with modest extra cost and longer solve time.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improves frequency-security accuracy over linear FCOPF, but adds mixed-integer complexity and depends on training-data coverage.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluated under multiple load profiles and contingencies, including out-of-distribution high-load cases.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerLinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityReliabilityObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DeviceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MathematicalReformulationAndSurrogateConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorConventionalSourceOperationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MachineLearningSurrogateConstraint"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ConventionalGeneratorParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadDemandParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowStateParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusStateAndInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkTopologyAndIndexParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#AlgorithmicLearningParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicMarketEmissionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TemporalCouplingParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorActivePowerParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ActiveLoadDemandParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorCostCoefficientParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowLimitParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusVoltageAngleParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusActivePowerInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchActivePowerFlowParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TimeStepParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OptimizationDimensionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NeuralNetworkArchitectureParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NeuralNetworkInputParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NeuralNetworkLayerOutputParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TrainingLossParameter"/>
  <hasSourceFilePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data/01_paper_ingestion_workflow/01_input/01_source_papers/A_Deep_Neural_Network-based_Frequency_Predictor_for_Frequency-Constrained_Optimal_Power_Flow.pdf</hasSourceFilePath>
  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A_Deep_Neural_Network-based_Frequency_Predictor_for_Frequency-Constrained_Optimal_Power_Flow.pdf</hasSourceFileName>

  <hasModeledTechnology rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010423"/>
