<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Adversarially_Robust_Learning_Security_Constrained_Optimal_Power_Flow">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adversarially Robust Learning for Security-Constrained Optimal Power Flow</hasPaperTitle>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adversarially Robust Learning Security Constrained Optimal Power Flow</hasModelName>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2021</hasPublicationYear>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Priya L. Donti, Aayushya Agarwal, Neeraj Vijay Bedmutha, Larry Pileggi, J. Zico Kolter</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carnegie Mellon University</hasInstitution>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-k SCOPF is computationally expensive because contingencies grow combinatorially, especially for multiple simultaneous outages.</hasMotivation>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-k security-constrained operation of AC transmission grids with generator and line outages.</hasPowerSystemDomainFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EconomicValueObjective; SecurityReliabilityObjective; CostMinimizationObjective; RobustSecurityObjective</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NetworkPhysicsAndOperatingLimitConstraint; SecurityStabilityAndReserveConstraint; UncertaintyScenarioAndRobustnessConstraint; ACPowerBalanceConstraint; ContingencyPostContingencyOperationConstraint</hasConstraintFunction>
