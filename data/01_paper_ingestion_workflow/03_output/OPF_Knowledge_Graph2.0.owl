            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00040010"/>
                <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010490"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Exogenous data can carry a physical unit.</rdfs:comment>
        <rdfs:comment>Exogenous data can describe grid-component information.</rdfs:comment>
        <rdfs:comment>Exogenous data describes electricity-grid information.</rdfs:comment>
        <rdfs:comment xml:lang="en">Exogenous data is a data item whose quantity value is determined outside of a model and is imposed on a model.</rdfs:comment>
        <rdfs:comment>Requirement extraction can use exogenous OPF input data.</rdfs:comment>
        <rdfs:label xml:lang="en">exogenous data</rdfs:label>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00030030 -->

