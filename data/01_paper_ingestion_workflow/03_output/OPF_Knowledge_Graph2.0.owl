<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Distributed_System_Level_Control_MTDC_Grids">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed System Level Control MTDC Grids</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed OPF Algorithm for System-Level Control of Active Multi-Terminal DC Distribution Grids</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2020</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/ACCESS.2020.3010876</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asimenia Korompili; Petros Pandis; Antonello Monti</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Institute for Automation of Complex Power Systems, E.ON Energy Research Center, RWTH Aachen University, Aachen, Germany</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed OPF-based system-level control of MTDC distribution grids with DER coordination.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Need fast, scalable, modular, privacy-preserving control for MTDC grids with high DER integration and changing operating conditions.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed solution of a nodal OPF-for-ANM problem for MTDC grids using ADMM and sequential convex approximation.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a distributed OPF algorithm coordinate diverse DER and provide nodal voltage set-points fast enough for system-level control in MTDC grids?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal nodal voltage set-points and DER power dispatch set-points; in simulations, nodal voltages and conventional DER power outputs are reported.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed, modular nodal formulation with ADMM coordination and local convexified subproblems.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nodal DC power-flow formulation with current, power-flow, and voltage variables; nonlinear power equations linearized by first-order Taylor approximation.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Repeated at each control period.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Control period-based, short periods.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period, receding control-period optimization.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses measured available RES power and current ESS SoC; no explicit stochastic or robust uncertainty model.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-terminal DC distribution grids with DER, ESS, controllable loads, and interlinking converters.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADMM with sequential convex approximation and an added initialization step for time-varying DER parameters.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluated for convergence speed, parallel computation time, communication time, scalability, and online cluster execution.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controllable loads can curtail demand with quadratic curtailment costs and bounds.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize conventional DER operating costs plus ADMM consensus penalty terms; ANM schemes add RES priority terms, ESS virtual-cost terms, or load-curtailment cost terms.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nodal current, line-current, nodal power balance, nonlinear power-flow equalities, and bounds on generation, line flows, voltages, ESS energy, ESS charge/discharge exclusivity, and load curtailment.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Penalty parameter ρ; voltage and power tolerances εV and εP; RES availability p̄RES; ESS SoC EESS,Ti and thresholds; charging/discharging efficiencies nch, ndisch; nodal price prk; load-curtailment factors aCL, bCL, cCL; priority factors priorRES and priorESS.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Each DCU solves its local nodal subproblem, exchanges voltage copies with neighbors, updates consensus voltages and dual variables, and stops when voltage convergence and total power balance are satisfied.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on modified IEEE 14, 30, 57, and 118-node systems, including sequential and physically distributed HPC-cluster implementations.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The algorithm converges in a few hundred iterations, remains scalable across network sizes, and can dispatch diverse DER under different ANM schemes with acceptable voltage deviations from centralized solutions.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: distributed, modular, scalable, privacy-preserving, fast. Limitations: relies on linearized OPF, assumes normal communication operation, and communication time can dominate total execution time.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Suitable for system-level control of DER-dominated MTDC grids and adaptable to equivalent AC-grid OPF-for-ANM formulations.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#UserSideServiceObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableResourceUtilizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadCurtailmentObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableDispatchTrackingObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowDistFlowPhysicsConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ConventionalGeneratorParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusStateAndInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowStateParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadDemandParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableGenerationParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EnergyStorageParameter"/>
