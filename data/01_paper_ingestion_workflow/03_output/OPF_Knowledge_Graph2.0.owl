</owl:NamedIndividual>
<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Neural_Networks_Encoding_Dynamic_Security_Constrained_AC_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neural Networks Encoding Dynamic Security Constrained AC OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neural Networks for Encoding Dynamic Security-Constrained Optimal Power Flow</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2022</hasPublicationYear>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ilgiz Murzakhanov; Andreas Venzke; George S. Misyris; Spyros Chatzivasileiadis</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technical University of Denmark</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Encode dynamic security constraints into a tractable optimization model for AC optimal power flow.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Directly including dynamic security constraints makes AC-OPF intractable; the paper seeks a scalable alternative.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC optimal power flow with N-1 security and small-signal stability constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can neural networks encode the feasible space of dynamic security-constrained AC-OPF so it can be solved as a MILP?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost-optimal generator dispatch satisfying N-1 security and small-signal stability, with corresponding bus voltages and line flows.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classification neural network encodes feasible operating points; exact mixed-integer reformulation with ReLU activations.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power flow balance for the intact system; contingency-wise AC constraints for N-1 security.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single operating point; no multi-period horizon.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Static steady-state operating point.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single snapshot dispatch.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None explicit; random cost-function test instances only.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-1 security and small-signal stability constraints on an IEEE 14-bus system.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neural-network feasibility encoding, exact MILP reformulation, and iterative linearization of power losses.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reported 99% test accuracy; feasibility improved to 100% with epsilon adjustment.</hasModelPerformanceFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize generation cost of the intact system state.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator active/reactive limits, voltage magnitude limits, line-flow limits, AC power balance, preventive generator set-point equality across contingencies, eigenvalue-based small-signal stability damping ratio constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator active and reactive limits, voltage limits, line-flow limits, contingency set C, damping threshold gamma_min, neural-network weights and biases, ReLU bounds, epsilon conservativeness parameter, loss-linearization threshold rho.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Train a ReLU classification network on feasible/infeasible operating points, reformulate it exactly as MILP, and iteratively linearize AC losses to solve MILPs with Gurobi.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on IEEE 14-bus system with 45,000 labeled samples; 99% test accuracy; compared against AC-OPF and N-1 security-constrained AC-OPF.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The approach obtained cost-optimal solutions satisfying both static and dynamic security constraints; epsilon increased feasibility to 100% with small cost increase.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: tractable MILP approximation and improved feasibility. Limitations: approximation error may cause optimality loss and separate networks are needed for different grids.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses a conservative feasibility margin epsilon to trade off feasibility and optimality.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerLinearProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
