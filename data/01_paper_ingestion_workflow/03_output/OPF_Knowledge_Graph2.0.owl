<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Hybrid_AC_DC_Network_VSC_MTDC_Renewables">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid AC DC Network VSC MTDC Renewables</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal Power Flow for Hybrid AC/DC Electrical Networks Configured With VSC-MTDC Transmission Lines and Renewable Energy Sources</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/JSYST.2023.3248658</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hüseyin Bakır; Ugur Guvenc; Serhat Duman; Hamdi Tolga Kahraman</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dogus University; Duzce University; Bandirma Onyedi Eylul University; Karadeniz Technical University</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Formulate and solve a single-objective OPF for hybrid AC/DC networks with VSC-MTDC links and renewable sources.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Need for cost-effective, secure AC/DC grid operation with renewable integration and limited prior OPF work on VSC-MTDC systems.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-objective OPF on a modified IEEE 30-bus hybrid AC/DC network with thermal generators, renewables, and VSC-MTDC links.</hasSolvedProblem>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal fuel cost, fuel cost with valve-point effect, fuel cost with emission-carbon tax, voltage deviation, and active power loss values; corresponding optimal dispatch and voltage profiles.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid AC/DC OPF with VSC-MTDC transmission lines and renewable energy sources.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power balance, DC power balance, line-flow loss terms, and VSC converter constraints.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period steady-state optimization.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not specified.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single operating point.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reserve and penalty cost modeling for stochastic wind, solar PV/small-hydro, and wind-tidal generation.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modified IEEE 30-bus AC/DC network with thermal generators, wind, solar PV, small-hydro, tidal, transformers, and VSC-MTDC grids.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDB-SFS metaheuristic with diffusion and FDB-based updating.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compared across 30 runs; FDB-SFS showed best objective values and robust convergence.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None reported.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize fuel cost; fuel cost with valve-point effect; fuel cost plus emission-carbon tax; voltage deviation; or active power loss, depending on the case.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC active/reactive power balance, DC power balance, generator active/reactive and voltage limits, load-bus voltage limits, line apparent-power limits, transformer tap limits, and VSC/DC voltage-power limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal cost and emission coefficients; valve-point coefficients; renewable direct/reserve/penalty cost coefficients; Weibull, Lognormal, and Gumbel distribution parameters; generator, voltage, line, tap, and VSC bounds.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDB-SFS, SFS, AGDE, MPA, and ASO were run for 200 iterations and 30 trials on the modified IEEE 30-bus system using MATACDC power-flow analysis.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Simulation results were checked against constraint limits and compared statistically using Wilcoxon and Friedman tests.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDB-SFS achieved the best results in all five cases, including lowest fuel cost, voltage deviation, and active power loss.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: integrates VSC-MTDC and multiple renewables in one OPF. Limitation: single-objective, static formulation; future work suggests multiobjective and dynamic OPF.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Future work proposed multiobjective optimization and dynamic OPF with load uncertainties.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EnvironmentalSustainabilityObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityReliabilityObjective"/>
