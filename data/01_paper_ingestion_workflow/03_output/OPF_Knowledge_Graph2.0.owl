<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Data_Driven_Physics_Informed_SELM_OPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Driven Physics Informed SELM OPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data-Driven Optimal Power Flow: A Physics-Informed Machine Learning Approach</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2021</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2020.3001919</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xingyu Lei; Zhifang Yang; Juan Yu; Junbo Zhao; Qian Gao; Hongxin Yu</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chongqing University; Mississippi State University; State Grid Chongqing Electric Power Company Electric Power Research Institute</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Learn OPF solutions directly from operating conditions using a physics-informed data-driven regression framework.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduce the high computational burden of repeated OPF solves and improve real-time applicability.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nonlinear, nonconvex OPF calculation for large-scale power systems with renewable uncertainty and many samples.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can SELM-based physics-informed decomposition and sample pre-classification accurately approximate OPF solutions faster than model-based and deep-learning methods?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generator active/reactive dispatch, bus voltage magnitudes/angles, branch active/reactive flows, and objective function value.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Three-stage SELM regression with reinforcement mode and sample pre-classification by active constraints.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-flow equations with branch-flow and voltage-state learning stages.</hasPowerFlowFormulationFeature>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monte Carlo-generated training samples with renewable and load fluctuations.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEEE 39, 57, 118-bus and Polish 2383-bus benchmark systems with wind and photovoltaic integration.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feature decomposition, reinforcement-mode SELM, and active-constraint sample clustering.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fast training and testing with improved accuracy over original SELM and deep-learning alternatives.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power demand inputs PDi and QDi; renewables treated as negative loads.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total generation operating cost, modeled as the sum of quadratic generator cost functions over generator buses.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power balance equations; branch active/reactive flow equations; generator active/reactive limits; bus voltage magnitude limits; branch flow limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator cost coefficients a2i, a1i, a0i; admittance conductance Gij and susceptance Bij; demand PDi, QDi; limits on PGi, QGi, Vi, PFk; penalty factor C.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Training samples are generated by Monte Carlo simulation and an interior-point OPF solver, then used to train SELM networks in three stages with reinforcement and classification.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on IEEE 39/57/118-bus and Polish 2383-bus systems; compared against original SELM, deep learning, and model-based OPF.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The proposed approach achieved the best accuracy and much faster computation, and direct learning with original SELM was intractable for OPF.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: fast, few hyperparameters, extensible across systems. Limitation: direct deep learning and original SELM struggle with OPF complexity; future work targets field-data validation.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sample pre-classification uses active-constraint critical regions to cluster similar OPF samples.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
