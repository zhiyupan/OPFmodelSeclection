  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DistributionNetworkTopologyReconfigurationConstraint"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowStateParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusStateAndInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkElectricalParameter"/>
