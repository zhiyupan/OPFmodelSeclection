<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Distributed_Variable_Estimation_ADMM">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed Variable Estimation ADMM</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Estimating Global Variables in Multi-agent Distributed OPF with Unreliable Communication</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2022</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TESC53336.2022.9917256</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Masoud Bashari; Mikhak Samadi; Javad Zare; Ashkan Rahimi-Kian</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEMS Group Ltd.; University of Ottawa</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve distributed optimal power flow under unreliable communication by estimating exchanged global variables.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Communication link disruptions can prevent consensus exchange in distributed OPF and degrade convergence and feasibility.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distributed OPF across multiple regions with lost or interrupted communication links between agents.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can predictive estimation of missing consensus messages preserve feasible D-OPF convergence when communication is interrupted?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regional bus voltage magnitudes and phase angles, weighted-average global bus voltages, and convergence of D-OPF results across iterations.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-agent distributed OPF with coordinator-agent consensus and predictive estimation of missing exchanged variables.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Region-based OPF coupled through tie-line voltage consensus and line power-flow equations.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iterative multi-region consensus over repeated ADMM iterations.</hasTimeHorizonFeature>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Handles unreliable communication by estimating missing consensus messages with a trained DFNN.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEEE 14-bus transmission network partitioned into three regions with PV units and a BESS.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extended ADMM combined with a shallow feedforward neural-network estimator for missing messages.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Faster convergence to actual global variables and feasible D-OPF results under interrupted links.</hasModelPerformanceFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total generation cost for each region/sub-network.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regional OPF constraints are enforced through bus-voltage and tie-line coupling; line power flows are updated from estimated voltages and consensus variables.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus voltage magnitudes and phase angles, tie-line voltages, line impedances, line currents, regional loads S_i,j^t, PV units, and BESS size.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEEE 14-bus case split into three areas; ADMM iterations compute regional OPF, estimate missing voltages with DFNN, average exchanged voltages, and update line flows.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compared three scenarios: normal communication, lost bus-5 communication, and lost communication recovered by estimation; tested on IEEE 14-bus case.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With DFNN-based estimation, interrupted-link cases converged closer to global voltages and faster than the unrecovered communication-loss case.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: improves distributed OPF feasibility and convergence under communication loss. Limitation: estimator still shows biased error and needs more training data.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANN/DFNN estimator trained on OPF data generated from 90%–100% loading scenarios.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TopologyAndDistributedCoordinationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#DistributedOPFCoordinationConstraint"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusStateAndInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableGenerationParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EnergyStorageParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicMarketEmissionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusVoltageMagnitudeParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusVoltageAngleParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GenerationCostParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#PVActivePowerParameter"/>
  <hasSourceFilePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data/01_paper_ingestion_workflow/01_input/01_source_papers/Estimating Global Variables in Multi-agent.pdf</hasSourceFilePath>
  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Estimating Global Variables in Multi-agent.pdf</hasSourceFileName>

  <hasModeledTechnology rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010423"/>
  <hasModeledTechnology rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010428"/>
  <oeo:OEO_00000505 rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000128"/>
</owl:NamedIndividual>
<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Feeder_Reconfiguration_Convex_Relaxation">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feeder Reconfiguration Convex Relaxation</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feeder Reconfiguration in Distribution Networks Based on Convex Relaxation of OPF</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2015</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2014.2356513</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qiuyu Peng; Yujie Tang; Steven H. Low</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">California Institute of Technology</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimize distribution feeder switch configurations for loss minimization or load balancing under radiality and power-flow constraints.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feeder reconfiguration is a mixed-integer nonlinear problem that is hard to solve directly; convex OPF relaxation offers an efficient alternative.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal feeder reconfiguration in distribution networks with switch status decisions and AC power-flow constraints.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can feeder reconfiguration be solved efficiently and near-optimally by leveraging convex relaxation of AC OPF?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal switch configuration and resulting power-loss-minimizing network topology; corresponding branch power flows and bus voltages from the solved OPF instances.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heuristic feeder-reconfiguration algorithm built on repeated AC OPF solves and SOCP relaxation.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Branch flow model with SOCP relaxation of AC power flow equalities.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period steady-state formulation.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Static, no time series.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One operating snapshot.</hasOptimizationHorizon>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radial distribution networks with sectionalizing and tie switches; substations, load buses, and optional PV injections.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses convex relaxation and branch-flow structure to avoid mixed-integer optimization; iterative line-opening heuristic.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linear-time in redundant lines for Algorithm 3; constant-complexity simplified Algorithm 4 with small optimality loss.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load balancing and loss minimization through feeder switch reconfiguration; distributed generation modeled as negative load injections.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total line loss, or alternatively minimize substation real power injection / balance substation loads depending on the reconfiguration objective.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiality constraints: each load bus connected to one substation and no loops; branch-flow power balance, voltage-drop equations, power-injection bounds, and voltage-magnitude limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Line impedances; bus power injections/loads; voltage magnitude bounds; substation voltage fixed at 1 p.u.; switch statuses; PV generation nameplate capacities in test cases.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solve OPF with all lines closed, identify minimum-branch-flow line(s), and open candidate line(s); repeat for multiple redundant lines.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on four practical distribution networks; Algorithm 3 matched optimal solutions, while Algorithm 4 had less than 3% loss gap.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The proposed method found globally optimal feeder configurations on tested networks and was computationally efficient.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengths: efficient, no parameter tuning, exact under certain assumptions. Limitation: optimality is not guaranteed in general, though empirical gaps were small.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SOCP relaxation assumed exact throughout the paper.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerNonlinearProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecondOrderConeProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TechnicalOperationPerformanceObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadBalancingObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkLossMinimizationObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MathematicalReformulationAndSurrogateConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TopologyAndDistributedCoordinationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ConvexRelaxationReformulationConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowDistFlowPhysicsConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
