<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Distribution_Grid_D_OPF_Benchmarking">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution Grid D OPF Benchmarking</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution Grid Optimal Power Flow (D-OPF): Modeling, Analysis, and Benchmarking</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2022.3204227</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rahul Ranjan Jha; Adedoyin Inaolaji; Biswajit Dipan Biswas; Arun Suresh; Anamika Dubey; Sumit Paudyal; Sukumar Kamalasadan</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Washington State University; Florida International University; University of North Carolina at Charlotte; ComEd</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Benchmark and compare distribution-grid OPF formulations for feasibility, optimality, and scalability.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution OPF is nonconvex and different relaxations/approximations can be infeasible, inexact, or poorly scalable.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution grid optimal power flow under loss minimization, PV hosting maximization, and voltage deviation minimization.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How do NLP, convex relaxation, and linearized D-OPF formulations compare in feasibility, optimality, and scalability across problem types and feeder sizes?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generation dispatch, DG active/reactive power dispatch, bus voltage profiles, branch power flows/current magnitudes, and PV hosting capacity.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deterministic, continuous, single-period benchmarking of multiple D-OPF formulations.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus injection and branch flow formulations; nonlinear, SOCP, SDP, and LinDistFlow variants.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period.</hasTimeHorizonFeature>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-period steady-state.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None; deterministic formulation.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radial distribution feeders with DGs, capacitor banks, voltage regulators, and substation bus.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Numerical benchmarking and visualization of feasible solution spaces; comparison across formulations and feeder sizes.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assesses feasibility gap, exactness, solve time, scalability, and AC-feasibility.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constant-power loads; no explicit demand response or flexible demand.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total power loss; maximize PV hosting capacity; minimize sum of voltage deviations from a setpoint.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC or approximate power-balance equations; voltage magnitude limits; branch current or apparent-power limits; DG apparent-power/reactive-power limits; PV unity-power-factor or reactive-power-control constraints; convex-relaxation PSD/rank or cone constraints.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load demands pL,i and qL,i; line impedances rij and xij; admittance Yij; voltage limits Vmin/Vmax; voltage setpoint vset; DG ratings sratedDG,i and pDG,max; branch current rating Iratedij; substation voltage Vsub.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solved with IPOPT, Knitro, Gurobi, CVX, MOSEK, and CPLEX on 123-, 730-, and 2522-node feeders; validated with OpenDSS and MATPOWER.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compared against OpenDSS substation power flows and MATPOWER; small cases matched closely for exact formulations, while relaxed/linear models were checked for feasibility gaps.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SOCP and SDP are exact for loss minimization but often inexact for PV hosting and voltage-deviation objectives; NLP-BIM scales better than NLP-BFM; LinDistFlow can misestimate losses, voltages, and PV hosting.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: comprehensive, implementation-centric comparison across formulations and feeder sizes. Limitation: balanced single-phase, deterministic, single-period study; unbalanced multi-phase and richer PV-hosting constraints are not fully addressed.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#QuadraticallyConstrainedQuadraticProgrammingProblem"/>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecondOrderConeProgrammingProblem"/>
