<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Efficient_Distribution_System">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Efficient Distribution System</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Efficient Distribution System Optimal Power Flow With Discrete Control of Load Tap Changers</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2019</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TPWRS.2019.2894674</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sharabh R. Shukla; Sumit Paudyal; Mads R. Almassalkhi</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Michigan Technological University; University of Vermont</hasInstitution>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rounding relaxed discrete controls can cause infeasible or suboptimal DOPF solutions; MINLP formulations are computationally difficult.</hasMotivation>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radial distribution feeders with load tap changers; also tests with curtailable PV generation.</hasPowerSystemDomainFeature>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NetworkPhysicsAndOperatingLimitConstraint; ACPowerBalanceConstraint; BranchFlowDistFlowPhysicsConstraint; LineFlowAndCapacityConstraint; VoltageAngleOperatingBoundaryConstraint</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BranchFlowStateParameter; BusStateAndInjectionParameter; NetworkTopologyAndIndexParameter; TemporalCouplingParameter; BranchActivePowerFlowParameter; BranchReactivePowerFlowParameter; BranchCurrentSquaredParameter; PowerFlowStateVectorParameter; BusActivePowerInjectionParameter; BusReactivePowerInjectionParameter; BusVoltageMagnitudeParameter; BusVoltageMagnitudeLimitParameter; BranchSetParameter; BusSetParameter</usesParameter>
