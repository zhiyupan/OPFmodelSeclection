  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorSetParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusSetParameter"/>
