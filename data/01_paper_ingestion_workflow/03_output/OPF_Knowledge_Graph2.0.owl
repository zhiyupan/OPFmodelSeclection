<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Unbalanced_Three_Phase_TOPF">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unbalanced Three Phase TOPF</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unbalanced Three-Phase Optimal Power Flow for Smart Grids</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TIE.2011.2106099</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sergio Bruno; Silvia Lamonaca; Giuseppe Rotondo; Ugo Stecchi; Massimo La Scala</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Politecnico di Bari, Bari, Italy</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unbalanced three-phase optimal power flow for smart-grid distribution management and control.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adapt OPF to strongly unbalanced distribution networks with distributed generation, single-phase loads, and smart-grid control needs.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Security-constrained load curtailment, phase-current constraint handling, loss minimization via reactive redispatch, and coordinated active-reactive control in unbalanced distribution feeders.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a three-phase unbalanced OPF be formulated and solved efficiently for smart-grid distribution operation under unbalanced conditions?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal load curtailment amounts, phase currents, line current, loss reduction, reactive power redispatch of capacitor banks and microgenerators, and bus voltage magnitudes.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Three-phase unbalanced distribution OPF using quasi-Newton iterations with OpenDSS load flow.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uses full multiphase or sequence load-flow equations; three-phase unbalanced distribution load flow.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extended real-time operation framework.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approximately every 15–30 min.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Daily system operation in extended real time.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mentions stochastic processes in OpenDSS and random variables, but no explicit stochastic OPF formulation.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smart-grid distribution management with unbalanced radial feeders, AMI/AMR, DG, capacitors, and microgeneration.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quasi-Newton method with Barzilai-Borwein step size and numerical sensitivity evaluation.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compatible with extended real-time requirements; tested on IEEE 123-bus feeder.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active load demand is a control variable; load curtailment via discounted tariffs and AMR-based demand control.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize a chosen objective Cobj(x,u), including load-curtailment cost or normalized total losses depending on the test case.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equality load-flow equations; inequality limits for thermal/capacity constraints, voltage profiles, maximum reactive injection, and hard bounds on control variables.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Control variables include active load demand, reactive outputs of microgenerators, capacitor-bank reactive power, current limits, voltage limits, penalty weights, and control-variable bounds.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matlab evaluates sensitivities and updates controls; OpenDSS performs three-phase load flow through COM interface; iterations continue until control updates are below tolerance.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on the IEEE 123-bus Radial Distribution Feeder with multiple tests for overload relief, phase-current constraints, loss minimization, and coordinated control.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phase-specific constraints reduce unnecessary curtailment; reactive redispatch lowers losses and improves balancing; coordinated active-reactive control reduces curtailment further.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flexible across several OPF objectives and control sets, but computational burden is higher than single-phase OPF and phase-sequence penalties may not fully capture per-phase overloads in all cases.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Implemented with OpenDSS and Matlab via COM interface for distribution-system analysis.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#UserSideServiceObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TechnicalOperationPerformanceObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadCurtailmentObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkLossMinimizationObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ReactivePowerSupportObjective"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#NetworkPhysicsAndOperatingLimitConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ACPowerBalanceConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LineFlowAndCapacityConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#VoltageAngleOperatingBoundaryConstraint"/>
  <hasConstraintFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ThreePhaseUnbalancedNetworkPhysicsConstraint"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#LoadDemandParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowStateParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusStateAndInjectionParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ConventionalGeneratorParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableGenerationParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ControllableDeviceParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ActiveLoadDemandParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#ReactivePowerLossParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchCurrentParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BranchFlowLimitParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusVoltageMagnitudeParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusVoltageMagnitudeLimitParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#GeneratorReactivePowerParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#RenewableReactivePowerParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CompensationDeviceSetParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#TransformerTapRatioParameter"/>
  <usesParameter rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#BusVoltageAngleParameter"/>
