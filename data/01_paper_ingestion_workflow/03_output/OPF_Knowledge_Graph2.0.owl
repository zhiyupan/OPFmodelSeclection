<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Stochastic_Voltage_Stability_Constrained_EMS">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stochastic Voltage Stability Constrained EMS</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Stochastic Voltage Stability Constrained EMS for Isolated Microgrids in the Presence of PEVs Using a Coordinated UC-OPF Framework</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2021</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/TIE.2020.2987271</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Saman Nikkhah; Mohamad-Amin Nasr; Abbas Rabiee</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Newcastle University; Amirkabir University of Technology; University of Zanjan</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stochastic energy management of isolated microgrids with coordinated UC-OPF under voltage stability constraints.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wind power uncertainty and PEV integration can affect microgrid voltage stability and secure operation.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coordinated unit commitment and optimal power flow for isolated microgrids with wind, PV, ESS, and PEVs under stochastic voltage-stability limits.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How do wind uncertainty and PEVs affect voltage stability margin and optimal EMS scheduling in isolated microgrids?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal generator on/off status and dispatch, ESS charge/discharge schedule, PEV charging/discharging schedule, bus voltages, branch flows, and loading margin.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stochastic scenario-based UC-OPF with voltage-stability-constrained EMS.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power balance equations with bus voltage magnitudes/angles and branch apparent-power limits.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-period hourly scheduling over 24 hours.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1 hour</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 hours</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scenario-based stochastic wind-power modeling using Weibull-derived scenarios.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isolated microgrid with diesel generators, wind turbines, PV units, ESS, and PEV parking lots.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coordinated UC and OPF solved as MINLP in GAMS; DICOPT with relaxed MINLP warm start.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Validated on a modified CIGRE benchmark microgrid; DICOPT reported as most efficient solver.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PEV parking lots modeled with charging/discharging limits and energy constraints.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total operating cost: quadratic generation cost plus start-up and shut-down costs over all time intervals and scenarios.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active/reactive power balance; generator output limits; ramp-up/down limits; minimum up/down times; start-up/shut-down logic; spinning reserve; branch flow and voltage limits; L-index voltage-stability limit; wind/PV output relations; ESS SOC and charge/discharge limits; PEV energy, charging/discharging, and parking-lot capacity limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator cost coefficients ag, bg, cg, Csupg, Csdng; reserve requirement RESt; voltage limits Vmin/Vmax; branch limits Smaxij; L-index limit Llimt; wind scenario probabilities πs and mean wind speeds vs; PEV capacities and efficiencies; ESS capacities and efficiencies; ramp rates Rupg/Rdng; minimum up/down times Tupg/Tdng.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Formulated as a stochastic MINLP in GAMS and solved with commercial MINLP solvers; DICOPT used with an initial relaxed NLP solution from CONOPT.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tested on a modified CIGRE microgrid benchmark with five wind scenarios and compared across cases with/without PEVs and voltage-stability constraints.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PEVs improve voltage stability margin; wind uncertainty reduces it; voltage-stability constraints alter optimal dispatch and PEV parking-lot capacity; stochastic modeling lowers energy loss versus deterministic wind.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: jointly captures UC, OPF, stochastic wind, voltage stability, ESS, and PEVs. Limitation: relies on scenario-based wind modeling and simplified PEV battery behavior.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loading margin is treated as a scenario-dependent variable.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerNonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#SecurityReliabilityObjective"/>
