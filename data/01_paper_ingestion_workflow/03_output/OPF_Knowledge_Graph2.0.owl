  <hasSourceFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss_Reduction_in_a_Windfarm_Participating_in_Primary_Voltage_Control_Using_an_Extension_of_the_Convex_DistFlow_OPF.pdf</hasSourceFileName>

