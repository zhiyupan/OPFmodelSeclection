<!--
Generated OPFModel individuals extracted from papers by the two-pass LLM workflow.
Each single-paper write appends a checked model or replaces an existing individual with the same stable paper metadata.
hasModelName is deliberately ignored for duplicate detection because it is LLM-generated and unstable.
-->
<owl:NamedIndividual rdf:about="http://www.semanticweb.org/bochengxu/OPF_Ontology#Hybrid_UC_OPF_Renewable_Integrated_Power_Systems">
  <rdf:type rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#OPFModel"/>
  <hasModelName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid UC OPF Renewable Integrated Power Systems</hasModelName>
  <hasPaperTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid UC–OPF Optimization for Renewable-Integrated Power Systems</hasPaperTitle>
  <hasPublicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2025</hasPublicationYear>
  <hasDOI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1109/COSITE68330.2025.11414305</hasDOI>
  <hasAuthor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muhammad Nurul Hadi; Ramdhan Halid Siregar; Rakhmad Syafutra Lubis</hasAuthor>
  <hasInstitution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Department of Electrical and Computer Engineering, Universitas Syiah Kuala, Banda Aceh, Indonesia</hasInstitution>
  <hasPrimaryPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimize unit commitment and power flow feasibility for renewable-integrated power systems with PV and pumped hydro storage.</hasPrimaryPurpose>
  <hasMotivation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermittent PV output creates scheduling and power-flow feasibility challenges that require flexible generation management.</hasMotivation>
  <hasSolvedProblem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Day-ahead UC-OPF scheduling for a modified IEEE 30-bus system with thermal generators, PV, and pumped hydro storage.</hasSolvedProblem>
  <hasResearchQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can a hybrid MINLP–PSO approach produce a cost-effective UC schedule while satisfying power-flow constraints under varying PV outputs?</hasResearchQuestion>
  <hasPrimaryOutput rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optimal hourly generator dispatch, PV and PHS operating schedules, bus voltages, line flows, and total operational cost/penalty values.</hasPrimaryOutput>
  <hasModelFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hybrid two-stage UC then OPF refinement; MINLP scheduling followed by PSO-assisted Newton-Raphson feasibility correction.</hasModelFeature>
  <hasPowerFlowFormulationFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC power-flow equations with bus voltage, reactive power, and line capacity constraints.</hasPowerFlowFormulationFeature>
  <hasTimeHorizonFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24-hour day-ahead planning horizon with hourly load and PV profiles.</hasTimeHorizonFeature>
  <hasTemporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hourly.</hasTemporalResolution>
  <hasOptimizationHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 hours.</hasOptimizationHorizon>
  <hasUncertaintyHandlingFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Varying PV outputs are tested, but no explicit stochastic or robust uncertainty model is formulated.</hasUncertaintyHandlingFeature>
  <hasPowerSystemDomainFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modified IEEE 30-bus system with thermal generators, PV at bus 6, and PHS at bus 25.</hasPowerSystemDomainFeature>
  <hasSolutionMethodEnhancementFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIP-MINLP initial solve, Newton-Raphson feasibility check, then PSO refinement for violated hours.</hasSolutionMethodEnhancementFeature>
  <hasModelPerformanceFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduces power-flow violations by more than 99% and lowers penalty from 302,210.9 to 2,128.49.</hasModelPerformanceFeature>
  <hasDemandSideFeature rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hourly load profile is fixed; no demand response or flexible demand model is included.</hasDemandSideFeature>
  <hasObjectiveFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimize total operational cost over 24 hours, including thermal fuel cost, start-up and shut-down cost, and PHS operating cost.</hasObjectiveFunction>
  <hasConstraintFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generator active and reactive limits, minimum up/down times, ramp-rate limits, PHS storage/capacity bounds, power balance, bus voltage limits, and transmission line capacity limits.</hasConstraintFunction>
  <usesParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quadratic fuel-cost coefficients a, b, c; generator min/max active and reactive limits; minimum up/down times; ramp rates; PHS capacity, efficiency, initial storage, O&amp;M cost; penalty weights for voltage, power, reactive power, line, ramp, and NR convergence violations.</usesParameter>
  <hasSolutionDetailsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIP solves UC first; Newton-Raphson checks feasibility; PSO optimizes only hours with violations using a penalty-based fitness function.</hasSolutionDetailsSummary>
  <hasModelValidationSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tested on a modified IEEE 30-bus system with 24-hour load and PV data; OPF refinement substantially reduced violations and penalties.</hasModelValidationSummary>
  <hasFindingsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UC alone gave the lowest cost but infeasible power flow; OPF refinement slightly increased cost while making the schedule technically feasible.</hasFindingsSummary>
  <hasStrengthsAndLimitationsSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength: balances economic dispatch and feasibility with large penalty reduction. Limitation: no explicit stochastic uncertainty model; PSO is applied only after detecting violations.</hasStrengthsAndLimitationsSummary>
  <isScenarioSuitability rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isScenarioSuitability>
  <hasFurtherProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHS operates mainly as a balancing/backup resource with relatively low output.</hasFurtherProperty>
  <hasMathematicalProblemType rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#MixedIntegerNonlinearProgrammingProblem"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#EconomicValueObjective"/>
  <hasObjectiveFunction rdf:resource="http://www.semanticweb.org/bochengxu/OPF_Ontology#CostMinimizationObjective"/>
